<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Recorder</RootNamespace>
    <AssemblyName>LokuOnX</AssemblyName>
    <Version>0.0.1</Version>
    <ApplicationIcon>..\assets\icon\LokuOnX.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- 自己完結型・単一ファイル発行（PROJECT.md §4-2） -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\assets\icon\LokuOnX.ico" Link="LokuOnX.ico" />
  </ItemGroup>

  <!-- 画面の文言（既定の日本語）。exe に埋め込む。配布では Lang/ja.ini も exe の隣に置き、編集で上書きできる（PROJECT.md §3-10） -->
  <ItemGroup>
    <EmbeddedResource Include="Lang\ja.ini" LogicalName="Lang.ja.ini" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!-- WPF では ImplicitUsings に System.IO が含まれないため明示する（PROJECT.md §5-19） -->
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

</Project>

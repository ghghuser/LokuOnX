<UserControl x:Class="Recorder.UI.HotkeyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Recorder.UI">
    <StackPanel>
        <TextBlock Text="{ui:T hotkey.title}" Style="{StaticResource SectionTitle}"/>
        <Border Style="{StaticResource SectionBody}">
            <StackPanel>
                <CheckBox x:Name="OnCheck" Content="{ui:T hotkey.use}" Margin="0,0,0,6"
                          Checked="On_Changed" Unchecked="On_Changed"/>
                <WrapPanel Margin="0,0,0,4">
                    <TextBlock Text="{ui:T hotkey.start}" Width="130" VerticalAlignment="Center"/>
                    <TextBox x:Name="StartBox" Tag="start" Width="170" IsReadOnly="True" IsReadOnlyCaretVisible="False" VerticalContentAlignment="Center"
                             ToolTip="{ui:T hotkey.box.tip}"
                             PreviewKeyDown="Key_PreviewKeyDown" GotKeyboardFocus="Box_Focus" LostKeyboardFocus="Box_Focus"/>
                    <Button Content="{ui:T hotkey.clear}" Tag="start" Padding="10,2" Margin="6,0,0,0" Click="Clear_Click"/>
                    <Button Content="↺" Tag="start" FontFamily="Segoe UI Symbol" Padding="9,2" Margin="6,0,0,0" Click="Restore_Click"
                            ToolTip="{ui:T hotkey.restore.tip}"/>
                </WrapPanel>
                <WrapPanel Margin="0,0,0,4">
                    <TextBlock Text="{ui:T hotkey.pause}" Width="130" VerticalAlignment="Center"/>
                    <TextBox x:Name="PauseBox" Tag="pause" Width="170" IsReadOnly="True" IsReadOnlyCaretVisible="False" VerticalContentAlignment="Center"
                             ToolTip="{ui:T hotkey.box.tip}"
                             PreviewKeyDown="Key_PreviewKeyDown" GotKeyboardFocus="Box_Focus" LostKeyboardFocus="Box_Focus"/>
                    <Button Content="{ui:T hotkey.clear}" Tag="pause" Padding="10,2" Margin="6,0,0,0" Click="Clear_Click"/>
                    <Button Content="↺" Tag="pause" FontFamily="Segoe UI Symbol" Padding="9,2" Margin="6,0,0,0" Click="Restore_Click"
                            ToolTip="{ui:T hotkey.restore.tip}"/>
                </WrapPanel>
                <WrapPanel Margin="0,0,0,4">
                    <TextBlock Text="{ui:T hotkey.split}" Width="130" VerticalAlignment="Center"/>
                    <TextBox x:Name="SplitBox" Tag="split" Width="170" IsReadOnly="True" IsReadOnlyCaretVisible="False" VerticalContentAlignment="Center"
                             ToolTip="{ui:T hotkey.box.tip}"
                             PreviewKeyDown="Key_PreviewKeyDown" GotKeyboardFocus="Box_Focus" LostKeyboardFocus="Box_Focus"/>
                    <Button Content="{ui:T hotkey.clear}" Tag="split" Padding="10,2" Margin="6,0,0,0" Click="Clear_Click"/>
                    <Button Content="↺" Tag="split" FontFamily="Segoe UI Symbol" Padding="9,2" Margin="6,0,0,0" Click="Restore_Click"
                            ToolTip="{ui:T hotkey.restore.tip}"/>
                </WrapPanel>
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,2,0,4" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

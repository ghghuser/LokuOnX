<Window x:Class="Recorder.UI.OutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Recorder.UI"
        Title="{ui:T outputwindow.window1.title}" Width="920" Height="620" MinWidth="470" MinHeight="360"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource WindowFg}"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="14"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <ui:DeviceIconBrushConverter x:Key="IconBrush"/>
        <ui:WarnBrushConverter x:Key="WarnBrush"/>
        <!-- 出力先の1項目: 入力デバイスと同じ色のアイコン・名前・既定の ＊ -->
        <DataTemplate x:Key="OutItem">
            <TextBlock>
                <Run Text="{Binding Icon, Mode=OneWay}" Foreground="{Binding Icon, Mode=OneWay, Converter={StaticResource IconBrush}}"/><Run Text="{Binding LabelAfterIcon, Mode=OneWay}"><Run.Foreground><MultiBinding Converter="{StaticResource WarnBrush}"><Binding Path="Id"/><Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ComboBox}"/><Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=ComboBoxItem}"/><Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=ComboBox}"/></MultiBinding></Run.Foreground></Run><Run Text="{Binding DefaultMark, Mode=OneWay}" Foreground="{DynamicResource DefaultMarkFg}"/>
            </TextBlock>
        </DataTemplate>
    </Window.Resources>
    <!-- M11-3: 出力カード（最大4枚）。狭いときはカードが折り返す（横スクロールはしない） -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,14,4,8">
            <DockPanel Margin="0,0,12,4">
                <!-- 表示の切り替え: ⊞＝カード式（全部を並べる）／🗇＝タブ式（1つずつ。既定）。いまの表示は濃く -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ViewCardButton" Content="⊞" Width="32" Padding="0,2" Click="ViewCard_Click" ToolTip="{ui:T outputwindow.viewcard.tip}"/>
                    <Button x:Name="ViewTabButton" Content="🗇" Width="32" Padding="0,2" Margin="4,0,0,0" Click="ViewTab_Click" ToolTip="{ui:T outputwindow.viewtab.tip}"/>
                </StackPanel>
                <TextBlock Text="{ui:T outputwindow.textblock1.text}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="DescriptionText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,12,10"
                       Text="{ui:T outputwindow.textblock2.text}"/>
            <!-- 出力の録音（M13）の一括操作 -->
            <WrapPanel Margin="0,0,0,12">
                <Button x:Name="RecWithButton" Padding="12,4" Margin="0,0,8,0" Click="RecWith_Click" ToolTip="{ui:T outputwindow.recwith.tip}"/>
                <Button x:Name="RecAllButton" Padding="12,4" Click="RecAll_Click" ToolTip="{ui:T outputwindow.recall.tip}"/>
            </WrapPanel>
            <WrapPanel x:Name="Cards"/>
            <TabControl x:Name="Tabs" Margin="0,0,12,8" Visibility="Collapsed"/>
            <!-- 「出力を追加」: カード式のときは最後のカードの右（入らなければ下）、タブ式のときは一番右のタブ（OutputWindow.xaml.cs の ApplyView が置く） -->
            <Button x:Name="AddButton" Content="{ui:T outputwindow.addbutton.content}" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="14,4" Margin="0,0,0,12"
                    ToolTip="{ui:T outputwindow.addbutton.tooltip}" Click="Add_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>

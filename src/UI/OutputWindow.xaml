<Window x:Class="Recorder.UI.OutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Recorder.UI"
        Title="出力" Width="500" SizeToContent="Height" MinWidth="440"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource WindowFg}"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="14"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanMinimize">
    <!-- M11-2: 出力は1台（カード1枚）。複数台・名前・エフェクトは M11-3 以降 -->
    <StackPanel Margin="16,14,16,16">
        <TextBlock Text="出力" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
        <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="メイン画面で選んでいる入力のミックスを、録音とは別に再生デバイス（スピーカー・ヘッドホン・VB-CABLE など）へ出します。録音しなくても使えます。「出力する」は、起動のたびにオフから始まります。"/>

        <Border CornerRadius="10" BorderThickness="1" Padding="16,12"
                Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <CheckBox x:Name="OnCheck" DockPanel.Dock="Right" Content="出力する" VerticalAlignment="Center"
                              ToolTip="オンにすると、出力先の再生デバイスへ音を送ります。入力が選ばれていて、出力先が決まっている必要があります"
                              Checked="On_Changed" Unchecked="On_Changed"/>
                    <TextBlock x:Name="NameText" Text="ミックス1" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>

                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="出力先" Width="52" VerticalAlignment="Center"/>
                    <ComboBox x:Name="DeviceBox" IsEnabled="False" SelectionChanged="Device_Changed"
                              ToolTip="音を送る再生デバイス。「入力のPC内部音（🔊）」と同じデバイスは、音が回ってしまうので選べません（赤文字で知らせます）"/>
                </DockPanel>

                <TextBlock x:Name="StateText" FontSize="12" Opacity="0.85" Text="読み込み中…"/>
                <TextBlock x:Name="ErrorText" Foreground="#D33" FontWeight="SemiBold" FontSize="12"
                           TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0"/>

                <Border x:Name="MeterHost" Margin="0,10,0,0"/>

                <TextBlock x:Name="InfoText" FontSize="11" Opacity="0.55" TextWrapping="Wrap" Margin="0,8,0,0"
                           ToolTip="出力デバイスの形式と、途切れ・捨てた回数（時計ズレの補正の確認用）"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>

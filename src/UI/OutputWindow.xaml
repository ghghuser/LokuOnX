<Window x:Class="Recorder.UI.OutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Recorder.UI"
        Title="出力ミキサー" Width="920" Height="620" MinWidth="470" MinHeight="360"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource WindowFg}"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="14"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <ui:DeviceIconBrushConverter x:Key="IconBrush"/>
        <ui:WarnBrushConverter x:Key="WarnBrush"/>
        <!-- 出力先の1項目: 入力デバイスと同じ色のアイコン・名前・既定の ＊ -->
        <DataTemplate x:Key="OutItem">
            <TextBlock>
                <Run Text="{Binding Icon, Mode=OneWay}" Foreground="{Binding Icon, Mode=OneWay, Converter={StaticResource IconBrush}}"/><Run Text="{Binding LabelAfterIcon, Mode=OneWay}"><Run.Foreground><MultiBinding Converter="{StaticResource WarnBrush}"><Binding Path="Id"/><Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ComboBox}"/><Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=ComboBoxItem}"/><Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=ComboBox}"/></MultiBinding></Run.Foreground></Run><Run Text="{Binding DefaultMark, Mode=OneWay}" Foreground="{DynamicResource DefaultMarkFg}"/>
            </TextBlock>
        </DataTemplate>
    </Window.Resources>
    <!-- M11-3: 出力カード（最大4枚）。狭いときはカードが折り返す（横スクロールはしない） -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,14,4,8">
            <TextBlock Text="出力" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
            <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,12,10"
                       Text="メイン画面で選んでいる入力を、録音とは別に再生デバイス（スピーカー・ヘッドホン・VB-CABLE など）へ出します。録音しなくても使えます。出力は最大4つで、出力ごとに入力の送りと音量を決められます。各カードの左端のランプをつけると出力が始まります（ランプは起動のたびに消えた状態から始まります）。"/>
            <WrapPanel x:Name="Cards"/>
            <Button x:Name="AddButton" Content="＋ 出力を追加" HorizontalAlignment="Left" Padding="14,4" Margin="0,0,0,12"
                    ToolTip="出力を増やします（最大4つ）" Click="Add_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>

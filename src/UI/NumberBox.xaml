<UserControl x:Class="Recorder.UI.NumberBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="Box" VerticalContentAlignment="Center"/>
        <Grid Grid.Column="1" Width="13">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <RepeatButton x:Name="UpButton" Focusable="False" Padding="0" Click="Up_Click"
                          Delay="400" Interval="80">
                <TextBlock Text="▲" FontSize="6"/>
            </RepeatButton>
            <RepeatButton x:Name="DownButton" Grid.Row="1" Focusable="False" Padding="0" Click="Down_Click"
                          Delay="400" Interval="80">
                <TextBlock Text="▼" FontSize="6"/>
            </RepeatButton>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="Recorder.UI.PlayerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Recorder.UI">
    <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="4" Padding="10,6">
        <StackPanel>
            <TextBlock x:Name="NameText" Text="{ui:T playerpanel.nametext.text}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="PlayButton" Content="{ui:T playerpanel.playbutton.content}" Padding="14,3" Click="Play_Click"/>
                    <Button x:Name="StopButton" Content="{ui:T playerpanel.stopbutton.content}" Padding="14,3" Margin="6,0,0,0" Click="Stop_Click"
                            ToolTip="{ui:T playerpanel.stopbutton.tooltip}"/>
                </StackPanel>

                <Slider x:Name="PosSlider" Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center"
                        Minimum="0" Maximum="1" IsMoveToPointEnabled="True" IsEnabled="False"
                        ValueChanged="Pos_ValueChanged"
                        ToolTip="{ui:T playerpanel.posslider.tooltip}"/>
                <TextBlock x:Name="TimeText" Grid.Column="2" Text="0：00：00 / 0：00：00" VerticalAlignment="Center"
                           MinWidth="130" TextAlignment="Right"/>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{ui:T playerpanel.textblock1.text}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Slider x:Name="SpeedSlider" Width="200" VerticalAlignment="Center" Minimum="0.5" Maximum="2"
                            Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.25"
                            ValueChanged="Speed_ValueChanged"
                            ToolTip="{ui:T playerpanel.speedslider.tooltip}"/>
                    <TextBlock x:Name="SpeedText" Text="1.00×" VerticalAlignment="Center" Width="48" Margin="6,0,0,0"/>
                    <Button Content="1×" Padding="8,2" Click="SpeedReset_Click" ToolTip="{ui:T playerpanel.button1.tooltip}"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="ErrorText" Foreground="#D33" FontWeight="SemiBold" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,4,0,0"/>
        </StackPanel>
    </Border>
</UserControl>

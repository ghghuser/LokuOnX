<UserControl x:Class="Recorder.UI.ProfileBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Recorder.UI">
    <WrapPanel>
        <ComboBox x:Name="ProfileBox" Tag="InputBg" Width="220" IsEditable="True" Margin="0,0,8,2"
                  ToolTip="{ui:T profilebar.profilebox.tooltip}"
                  SelectionChanged="Profile_Selected" DropDownOpened="Profile_DropDownOpened"/>
        <Button Content="{ui:T profilebar.button1.content}" Padding="12,3" Margin="0,0,6,2" Click="Save_Click"/>
        <Button Content="{ui:T profilebar.button2.content}" Padding="12,3" Margin="0,0,6,2" Click="Delete_Click"/>
        <Button Content="{ui:T profilebar.button3.content}" Padding="12,3" Margin="0,0,6,2" Click="Revert_Click"
                ToolTip="{ui:T profilebar.button4.tooltip}"/>
        <Button Content="{ui:T profilebar.button5.content}" Padding="12,3" Margin="0,0,0,2"
                ToolTip="{ui:T profilebar.button6.tooltip}"
                Click="OpenFolder_Click"/>
    </WrapPanel>
</UserControl>

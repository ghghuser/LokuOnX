<Window x:Class="Recorder.UI.VariableEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Recorder.UI"
        Width="720" Height="520" MinWidth="560" MinHeight="400"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource WindowFg}"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="14"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{ui:T variableeditor.textblock1.text}" FontSize="12"/>
        <TextBox x:Name="Box" Grid.Row="1" Margin="0,6,0,6" VerticalContentAlignment="Center" Padding="4"
                 TextChanged="Box_TextChanged"/>
        <TextBlock x:Name="PreviewText" Grid.Row="2" Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <WrapPanel x:Name="Buttons" Grid.Row="3" Margin="0,0,0,10" TextElement.FontSize="12"/>
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" BorderBrush="#40808080" BorderThickness="1">
            <TextBlock x:Name="HelpText" Margin="10,8" TextWrapping="Wrap" FontSize="12" LineHeight="20"/>
        </ScrollViewer>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="90" Padding="0,5" IsDefault="True" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="{ui:T variableeditor.button1.content}" Width="90" Padding="0,5" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

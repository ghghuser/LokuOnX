<UserControl x:Class="Recorder.UI.OptionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Recorder.UI">
    <StackPanel>
        <TextBlock Text="{ui:T optionpanel.textblock1.text}" Style="{StaticResource SectionTitle}"/>
        <Border Style="{StaticResource SectionBody}">
            <StackPanel>
                <WrapPanel Margin="0,0,0,6">
                    <CheckBox x:Name="AutoStartCheck" Content="{ui:T optionpanel.autostartcheck.content}" VerticalAlignment="Center" Margin="0,0,10,0"
                              ToolTip="{ui:T optionpanel.autostartcheck.tooltip}"
                              Checked="Check_Changed" Unchecked="Check_Changed"/>
                    <TextBlock Text="{ui:T optionpanel.textblock2.text}" VerticalAlignment="Center"/>
                    <ui:NumberBox x:Name="AutoStartDbBox" Width="70" Minimum="10" Maximum="80" Margin="2,0,2,0"
                                  ToolTip="{ui:T optionpanel.autostartdbbox.tooltip}"
                                  LostFocus="Number_LostFocus"/>
                    <TextBlock Text="{ui:T optionpanel.textblock3.text}" VerticalAlignment="Center"/>
                </WrapPanel>
                <WrapPanel Margin="0,0,0,4">
                    <CheckBox x:Name="SilenceSplitCheck" Content="{ui:T optionpanel.silencesplitcheck.content}" VerticalAlignment="Center" Margin="0,0,10,0"
                              ToolTip="{ui:T optionpanel.silencesplitcheck.tooltip}"
                              Checked="Check_Changed" Unchecked="Check_Changed"/>
                    <TextBlock Text="{ui:T optionpanel.textblock4.text}" VerticalAlignment="Center"/>
                    <ui:NumberBox x:Name="SilenceDbBox" Width="70" Minimum="10" Maximum="80" Margin="2,0,2,0"
                                  ToolTip="{ui:T optionpanel.silencedbbox.tooltip}"
                                  LostFocus="Number_LostFocus"/>
                    <TextBlock Text="{ui:T optionpanel.textblock5.text}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ui:NumberBox x:Name="SilenceSecBox" Width="70" Minimum="1" Maximum="600"
                                  ToolTip="{ui:T optionpanel.silencesecbox.tooltip}"
                                  LostFocus="Number_LostFocus"/>
                    <TextBlock Text="{ui:T optionpanel.textblock6.text}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

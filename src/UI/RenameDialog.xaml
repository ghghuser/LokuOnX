<Window x:Class="Recorder.UI.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Recorder.UI"
        Title="{ui:T renamedialog.window1.title}" Width="620" SizeToContent="Height"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource WindowFg}"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="14"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="18">
        <TextBlock Text="{ui:T renamedialog.textblock1.text}" Margin="0,0,0,6"/>
        <DockPanel Margin="0,0,0,6">
            <TextBlock x:Name="ExtText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
            <TextBox x:Name="NameBox" VerticalContentAlignment="Center" Padding="2,3"/>
        </DockPanel>
        <TextBlock x:Name="ErrorText" Foreground="#D33" FontWeight="SemiBold" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,0,0,6"/>
        <TextBlock Text="{ui:T renamedialog.textblock2.text}" Opacity="0.7" Margin="0,0,0,14"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{ui:T renamedialog.button1.content}" Width="90" Padding="0,5" IsDefault="True" Click="Ok_Click"/>
            <Button Content="{ui:T renamedialog.button2.content}" Width="90" Padding="0,5" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>

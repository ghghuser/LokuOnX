<UserControl x:Class="Recorder.UI.SchedulePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Recorder.UI">
    <StackPanel>
        <TextBlock Text="{ui:T schedulepanel.textblock1.text}" Style="{StaticResource SectionTitle}"/>
        <Border Style="{StaticResource SectionBody}">
        <StackPanel>
        <CheckBox x:Name="OnCheck" Content="{ui:T schedulepanel.oncheck.content}" Margin="0,0,0,6"
                  ToolTip="{ui:T schedulepanel.oncheck.tooltip}"
                  Checked="Check_Changed" Unchecked="Check_Changed"/>
        <WrapPanel Margin="0,0,0,4">
            <TextBlock Text="{ui:T schedulepanel.textblock2.text}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ui:ClockBox x:Name="StartTimeBox" Width="90" Margin="0,0,16,0"
                         ToolTip="{ui:T schedulepanel.starttimebox.tooltip}"
                         LostFocus="Start_LostFocus"/>
            <TextBlock Text="{ui:T schedulepanel.textblock3.text}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ui:TimeBox x:Name="LengthBox" Width="70"
                        ToolTip="{ui:T schedulepanel.lengthbox.tooltip}"
                        LostFocus="Length_LostFocus"/>
            <TextBlock Text="{ui:T schedulepanel.textblock4.text}" VerticalAlignment="Center" Margin="8,0,16,0" Opacity="0.75"/>
            <ComboBox x:Name="RepeatBox" Width="128" SelectionChanged="Repeat_Changed">
                <ComboBoxItem Content="{ui:T schedulepanel.comboboxitem1.content}"/>
                <ComboBoxItem Content="{ui:T schedulepanel.comboboxitem2.content}"/>
            </ComboBox>
        </WrapPanel>
        <TextBlock x:Name="NextText" Margin="0,2,0,2" TextWrapping="Wrap"/>
        </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

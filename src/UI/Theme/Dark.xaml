<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ダーク: 色（ブラシ）と、色が付く部品の簡単なスタイル。ボタン・コンボボックスは DarkControls.xaml -->
    <SolidColorBrush x:Key="WindowBg" Color="#202124"/>
    <SolidColorBrush x:Key="WindowFg" Color="#E8EAED"/>
    <SolidColorBrush x:Key="PanelBg" Color="#802D2F33"/>
    <SolidColorBrush x:Key="PopupBg" Color="#2D2F33"/>
    <SolidColorBrush x:Key="PanelHover" Color="#B03C4043"/>
    <SolidColorBrush x:Key="PanelBorder" Color="#5F6368"/>
    <SolidColorBrush x:Key="Accent" Color="#4C8DFF"/>
    <SolidColorBrush x:Key="DisabledFg" Color="#7A7D82"/>
    <SolidColorBrush x:Key="NewFileFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OldFileFg" Color="#B3B7BD"/>
    <SolidColorBrush x:Key="MarkFg" Color="#6EA8FE"/>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource WindowFg}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource DisabledFg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- DeviceList が RadioButton の Style を持っているので、ここでは色だけ（そちらが優先される部分は Opacity のみ） -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
    </Style>

    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
    </Style>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ダーク: 色（ブラシ）と、色が付く部品の簡単なスタイル。ボタン・コンボボックスは DarkControls.xaml -->
    <SolidColorBrush x:Key="WindowBg" Color="#1A1B1D"/>
    <SolidColorBrush x:Key="WindowFg" Color="#DDDAD5"/>
    <SolidColorBrush x:Key="CautionFg" Color="#E8C23A"/>   <!-- 注意の黄（ダーク系。原色に近いが目に痛くない黄） -->
    <SolidColorBrush x:Key="PanelBg" Color="#802D2F33"/>
    <SolidColorBrush x:Key="PopupBg" Color="#2D2F33"/>
    <SolidColorBrush x:Key="PanelHover" Color="#B03C4043"/>
    <SolidColorBrush x:Key="PanelBorder" Color="#46494E"/>
    <SolidColorBrush x:Key="TabSelBg" Color="#30FFFFFF"/>
    <SolidColorBrush x:Key="LampOnRing" Color="#34D96B"/>
    <SolidColorBrush x:Key="Accent" Color="#4C8DFF"/>
    <SolidColorBrush x:Key="DisabledFg" Color="#7A7D82"/>
    <SolidColorBrush x:Key="NewFileFg" Color="#EEEBE6"/>
    <SolidColorBrush x:Key="OldFileFg" Color="#B2AEA8"/>
    <SolidColorBrush x:Key="MarkFg" Color="#9AA0A6"/>
    <!-- パステルイエロー（チェック・スライダー・選択行の線・フォーカス） -->
    <SolidColorBrush x:Key="Pastel" Color="#F3DD8A"/>
    <SolidColorBrush x:Key="PastelDim" Color="#6B5F2E"/>
    <SolidColorBrush x:Key="PastelText" Color="#3A3320"/>
    <SolidColorBrush x:Key="SelectOutline" Color="#C9CDD2"/>
    <SolidColorBrush x:Key="TrackBg" Color="#4A4D53"/>
    <SolidColorBrush x:Key="ThumbRing" Color="#121316"/>
    <!-- 録音コンソール（上段のカード）と波形の枠 -->
    <SolidColorBrush x:Key="CardBg" Color="#552A2C30"/>
    <SolidColorBrush x:Key="CardBorder" Color="#3A3D42"/>
    <SolidColorBrush x:Key="InputBg" Color="#802D2F33"/>   <!-- 入力欄（TextBox）と同じ背景。ファイル一覧・プリセット欄が使う -->
    <SolidColorBrush x:Key="LaneBg" Color="#40000000"/>
    <SolidColorBrush x:Key="LaneBorder" Color="#34373C"/>
    <SolidColorBrush x:Key="MeterBg" Color="#4A000000"/>
    <!-- 波形欄: 使うデバイスの行（WaveBg）は少し明るく、使わない行（WaveBgOff）は少し暗く -->
    <SolidColorBrush x:Key="WaveBg" Color="#151A24"/>
    <SolidColorBrush x:Key="WaveBgOff" Color="#10141C"/>
    <SolidColorBrush x:Key="WaveBorder" Color="#2B3344"/>
    <!-- 録音ボタンの文字色（白にうっすら緑／青）と、録音中の●の色（赤紫） -->
    <SolidColorBrush x:Key="StartFg" Color="#E3F3E8"/>
    <SolidColorBrush x:Key="StopFg" Color="#DEE8FA"/>
    <SolidColorBrush x:Key="RecDot" Color="#C94A86"/>
    <!-- 設定の見出し（淡い青）と中身の縦線、予約録音が有効なときの色（オレンジ系） -->
    <SolidColorBrush x:Key="SectionFg" Color="#8AB4F8"/>
    <SolidColorBrush x:Key="SectionBar" Color="#3F5C8F"/>
    <SolidColorBrush x:Key="ScheduleOnFg" Color="#FFAE5C"/>
    <SolidColorBrush x:Key="ScheduleOnBg" Color="#4D3018"/>
    <!-- 左下の設定グループの見出し（ラジオ・スライダーと同じパステルイエロー） -->
    <SolidColorBrush x:Key="GroupFg" Color="#F3DD8A"/>
    <!-- チェックボックス（丸いトグル式）。ON＝明るい青緑 -->
    <SolidColorBrush x:Key="ToggleOn" Color="#F3DD8A"/>
    <SolidColorBrush x:Key="ToggleOff" Color="#4A4D52"/>
    <SolidColorBrush x:Key="ToggleKnobOff" Color="#C9CCD1"/>
    <SolidColorBrush x:Key="ToggleKnobOn" Color="#3A3320"/>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource WindowFg}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource PastelDim}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Pastel}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
    </Style>
</ResourceDictionary>

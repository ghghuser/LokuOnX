<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ダーク: 色（ブラシ）と、色が付く部品の簡単なスタイル。ボタン・コンボボックスは DarkControls.xaml -->
    <SolidColorBrush x:Key="WindowBg" Color="#202124"/>
    <SolidColorBrush x:Key="WindowFg" Color="#DADDE1"/>
    <SolidColorBrush x:Key="PanelBg" Color="#802D2F33"/>
    <SolidColorBrush x:Key="PopupBg" Color="#2D2F33"/>
    <SolidColorBrush x:Key="PanelHover" Color="#B03C4043"/>
    <SolidColorBrush x:Key="PanelBorder" Color="#46494E"/>
    <SolidColorBrush x:Key="Accent" Color="#4C8DFF"/>
    <SolidColorBrush x:Key="DisabledFg" Color="#7A7D82"/>
    <SolidColorBrush x:Key="NewFileFg" Color="#ECEEF1"/>
    <SolidColorBrush x:Key="OldFileFg" Color="#AEB2B8"/>
    <SolidColorBrush x:Key="MarkFg" Color="#9AA0A6"/>
    <!-- パステルイエロー（チェック・スライダー・選択行の線・フォーカス） -->
    <SolidColorBrush x:Key="Pastel" Color="#F3DD8A"/>
    <SolidColorBrush x:Key="PastelDim" Color="#6B5F2E"/>
    <SolidColorBrush x:Key="PastelText" Color="#3A3320"/>
    <SolidColorBrush x:Key="SelectOutline" Color="#C9CDD2"/>
    <SolidColorBrush x:Key="TrackBg" Color="#4A4D53"/>
    <SolidColorBrush x:Key="ThumbRing" Color="#121316"/>
    <!-- 録音コンソール（上段のカード）と波形の枠 -->
    <SolidColorBrush x:Key="CardBg" Color="#552A2C30"/>
    <SolidColorBrush x:Key="CardBorder" Color="#3A3D42"/>
    <SolidColorBrush x:Key="LaneBg" Color="#40000000"/>
    <SolidColorBrush x:Key="LaneBorder" Color="#34373C"/>
    <!-- 録音ボタンの文字色（白にうっすら緑／青）と、録音中の●の色（赤紫） -->
    <SolidColorBrush x:Key="StartFg" Color="#E3F3E8"/>
    <SolidColorBrush x:Key="StopFg" Color="#DEE8FA"/>
    <SolidColorBrush x:Key="RecDot" Color="#C94A86"/>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource WindowFg}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource PastelDim}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Pastel}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 丸みのあるチェックボックス（チェック時はパステルイエロー） -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Box" Width="19" Height="19" CornerRadius="4" BorderThickness="1.5"
                                BorderBrush="{DynamicResource PanelBorder}" Background="Transparent" VerticalAlignment="Center">
                            <Path x:Name="Tick" Data="M4,9.5 L8,13.5 L15,5.5" Stroke="{DynamicResource PastelText}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed" Margin="-1,-1,0,0"/>
                        </Border>
                        <ContentPresenter x:Name="Content" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Pastel}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Pastel}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Pastel}"/>
                        </Trigger>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Content" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledFg}"/>
                            <Setter TargetName="Box" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
    </Style>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ダーク用の ボタン と コンボボックス（色は Dark.xaml のブラシ） -->

    <ControlTemplate x:Key="DarkButtonTemplate" TargetType="ButtonBase">
        <Border x:Name="Bd" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelBorder}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource DisabledFg}"/>
                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
        <Setter Property="Template" Value="{StaticResource DarkButtonTemplate}"/>
    </Style>
    <Style TargetType="RepeatButton">
        <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
        <Setter Property="Template" Value="{StaticResource DarkButtonTemplate}"/>
    </Style>

    <ControlTemplate x:Key="DarkComboToggle" TargetType="ToggleButton">
        <Border x:Name="Bd" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="4">
            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                  Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource WindowFg}"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelHover}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PastelDim}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Template="{StaticResource DarkComboToggle}" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="Shown" IsHitTestVisible="False" Margin="6,3,26,3"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          ContentSource="SelectionBoxItem"/>
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Margin="3,2,24,2"
                                 Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                 Foreground="{DynamicResource WindowFg}" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False">
                            <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource PanelBorder}"
                                    BorderThickness="1" CornerRadius="4">
                                <ScrollViewer>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Shown" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 丸いつまみ（パステルイエロー）のスライダー。左側（つまみまで）を塗る -->
    <ControlTemplate x:Key="SliderFillTemplate" TargetType="RepeatButton">
        <Border Height="4" CornerRadius="2" Background="{DynamicResource Pastel}" VerticalAlignment="Center"/>
    </ControlTemplate>
    <ControlTemplate x:Key="SliderEmptyTemplate" TargetType="RepeatButton">
        <Border Background="Transparent" Height="20"/>
    </ControlTemplate>
    <ControlTemplate x:Key="SliderThumbTemplate" TargetType="Thumb">
        <Ellipse Width="16" Height="16" Fill="{DynamicResource Pastel}" Stroke="{DynamicResource WindowBg}" StrokeThickness="0"/>
    </ControlTemplate>

    <Style TargetType="Slider">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="Root" Height="20" Background="Transparent" SnapsToDevicePixels="True">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource PanelBorder}" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Template="{StaticResource SliderFillTemplate}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Template="{StaticResource SliderEmptyTemplate}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16" Focusable="False" Template="{StaticResource SliderThumbTemplate}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

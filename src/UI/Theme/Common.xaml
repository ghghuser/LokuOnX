<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ★ 色の調整はここ（ライト・ダーク共通。#RRGGBB を書き換えるだけで変わります） -->
    <SolidColorBrush x:Key="IconMicFg" Color="#2AA7D8"/>        <!-- 🎤 マイク（水色） -->
    <SolidColorBrush x:Key="IconSpeakerFg" Color="#F08A4B"/>    <!-- 🔊 スピーカー（橙） -->
    <SolidColorBrush x:Key="IconAsioFg" Color="#9B6BE8"/>       <!-- 🎛 ASIO（紫） -->
    <SolidColorBrush x:Key="DefaultMarkFg" Color="#CC3D8C"/>    <!-- 既定のデバイスの ＊（赤紫） -->
    <SolidColorBrush x:Key="WarnFg" Color="#E55757"/>            <!-- 注意・エラーの赤（エラー文字・プルダウンの注意項目で共通。WarnBrushConverter も同じ色） -->
    <SolidColorBrush x:Key="LampOn" Color="#34D96B"/>           <!-- 入力デバイスの「使う」ランプ（緑） -->
    <SolidColorBrush x:Key="LampErr" Color="#F04545"/>          <!-- ランプがONなのに使えていないとき（赤ランプ） -->
    <SolidColorBrush x:Key="LampErrRing" Color="#C42626"/>      <!-- 赤ランプの輪 -->

    <!-- 設定の「見出し」と「中身」を見分けやすくする共通スタイル（ライト・ダーク共通。色は Dark.xaml / Light.xaml の SectionFg・SectionBar）。
         見出し＝色付きの小さめの太字、中身＝左に細い縦線を引いて少し字下げ -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource SectionFg}"/>
        <Setter Property="Margin" Value="0,12,0,6"/>
    </Style>
    <Style x:Key="SectionBody" TargetType="Border">
        <Setter Property="BorderThickness" Value="2,0,0,0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SectionBar}"/>
        <Setter Property="Padding" Value="12,2,0,2"/>
        <Setter Property="Margin" Value="2,0,0,4"/>
    </Style>

    <!-- 左下の設定グループ: 枠の上辺の中央に小さめの黄色い見出しを埋め込む（ーーー 形式・音質 ーーー）。色は Dark.xaml / Light.xaml の GroupFg・CardBorder・WindowBg -->
    <Style x:Key="GroupFrame" TargetType="GroupBox">
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Border Margin="0,9,0,0" BorderThickness="1" BorderBrush="{DynamicResource CardBorder}"
                                CornerRadius="8" Padding="12,14,12,8">
                            <ContentPresenter/>
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,0,0,0" Padding="8,0"
                                Background="{DynamicResource WindowBg}">
                            <TextBlock Text="{TemplateBinding Header}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource GroupFg}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 入力行の小さな「FX」ボタン（11-4確認後）。テーマのボタン（影・余白が大きく、文字の下が見切れた）に頼らない、枠だけの小さな板。
         ON のときの色（青紫に光る）はコード（DeviceList.SetFxState）で変える -->
    <Style x:Key="FxButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="5" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="Transparent" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#26808080"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 入力デバイスの「使う」用。丸いランプ（ON＝緑に点灯、OFF＝消灯）。他のチェックボックスは下のトグル式 -->
    <Style x:Key="LampCheck" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" Width="22" Height="22" SnapsToDevicePixels="True">
                        <Ellipse x:Name="Lamp" Width="16" Height="16" StrokeThickness="1.5"
                                 Stroke="{DynamicResource ToggleOff}" Fill="Transparent"/>
                        <Ellipse x:Name="Ring" Width="16" Height="16" StrokeThickness="1.5" Stroke="{DynamicResource LampOnRing}"
                                 Fill="Transparent" Visibility="Collapsed">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#34D96B" BlurRadius="7" ShadowDepth="0" Opacity="0.9"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Lamp" Property="Fill" Value="{DynamicResource LampOn}"/>
                            <Setter TargetName="Lamp" Property="Stroke" Value="{DynamicResource LampOnRing}"/>
                            <Setter TargetName="Lamp" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#34D96B" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Lamp" Property="Stroke" Value="{DynamicResource LampOn}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                        <!-- 録音中などで変更できないとき: 全体は薄くなるが、ON のランプは縁だけ緑に光らせて「使っている」と分かるようにする -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Opacity" Value="1"/>
                            <Setter TargetName="Lamp" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <!-- 赤ランプ（Tag="Error"）: ONなのに正しく使えていない（出力＝出力できない／入力＝同じデバイスの重複など）。ONのときだけ赤く点灯 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Error"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Lamp" Property="Fill" Value="{DynamicResource LampErr}"/>
                            <Setter TargetName="Lamp" Property="Stroke" Value="{DynamicResource LampErrRing}"/>
                            <Setter TargetName="Lamp" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#E53935" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource LampErrRing}"/>
                            <Setter TargetName="Ring" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#E53935" BlurRadius="7" ShadowDepth="0" Opacity="0.9"/>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- すべてのチェックボックスを、丸いトグル式（ON＝黄色、つまみが右へ動く）にする。ライト・ダーク共通（色は Dark.xaml / Light.xaml の ToggleOn・ToggleOff・ToggleKnobOff） -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel x:Name="Root" Orientation="Horizontal" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid Width="34" Height="18" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="9" Background="{DynamicResource ToggleOff}"
                                    BorderThickness="1" BorderBrush="Transparent"/>
                            <Ellipse x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="3,0,0,0"
                                     Fill="{DynamicResource ToggleKnobOff}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobMove" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ContentPresenter x:Name="Content" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <!-- つまみの位置は状態で即決め（作った時点でONなら最初から右）。動かす演出はチェックの切り替え時だけ（11-4確認後2: 作り直しのたびに左から右へ動いていた） -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleOn}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleKnobOn}"/>
                            <Setter TargetName="Knob" Property="Margin" Value="19,0,0,0"/>
                        </Trigger>
                        <EventTrigger RoutedEvent="CheckBox.Checked">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" From="-16" To="0" Duration="0:0:0.12"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="CheckBox.Unchecked">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" From="16" To="0" Duration="0:0:0.12"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleOn}"/>
                        </Trigger>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Content" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

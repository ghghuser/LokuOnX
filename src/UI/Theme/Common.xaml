<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Recorder.UI">
    <!-- ★ 色の調整はここ（ライト・ダーク共通。#RRGGBB を書き換えるだけで変わります） -->
    <SolidColorBrush x:Key="IconMicFg" Color="#2AA7D8"/>        <!-- 🎤 マイク（水色） -->
    <SolidColorBrush x:Key="IconSpeakerFg" Color="#F08A4B"/>    <!-- 🔊 スピーカー（橙） -->
    <SolidColorBrush x:Key="IconAsioFg" Color="#9B6BE8"/>       <!-- 🎛 ASIO（紫） -->
    <SolidColorBrush x:Key="DefaultMarkFg" Color="#CC3D8C"/>    <!-- 既定のデバイスの ＊（赤紫） -->
    <SolidColorBrush x:Key="WarnFg" Color="#E55757"/>            <!-- 注意・エラーの赤（エラー文字・プルダウンの注意項目で共通。WarnBrushConverter も同じ色） -->
    <SolidColorBrush x:Key="LampOn" Color="#34D96B"/>           <!-- 入力デバイスの「使う」ランプ（緑） -->
    <SolidColorBrush x:Key="LampErr" Color="#F04545"/>          <!-- ランプがONなのに使えていないとき（赤ランプ） -->
    <SolidColorBrush x:Key="LampErrRing" Color="#C42626"/>      <!-- 赤ランプの輪 -->
    <SolidColorBrush x:Key="LampWarn" Color="#F0C93C"/>         <!-- 注意の黄ランプ（ONだが注意がある。黄文字の注意と同じ意味） -->
    <SolidColorBrush x:Key="LampWarnRing" Color="#B8921A"/>     <!-- 黄ランプの輪 -->
    <SolidColorBrush x:Key="LampRec" Color="#3DA5FF"/>          <!-- 録音中の青ランプ。出力の「録音に含める」の連動線（連動中）も同じ青 -->
    <SolidColorBrush x:Key="LampRecRing" Color="#1E78D0"/>      <!-- 青ランプの輪 -->


    <!-- スクロールバー: 細い角丸のつまみだけ（矢印ボタンなし）。色は各テーマの ScrollThumb / ScrollThumbHover / ScrollThumbDrag -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Focusable="False" IsTabStop="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar" Margin="2" CornerRadius="4" Background="{DynamicResource ScrollThumb}"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ScrollThumbHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ScrollThumbDrag}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="MinHeight" Value="12"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 設定の「見出し」と「中身」を見分けやすくする共通スタイル（ライト・ダーク共通。色は Dark.xaml / Light.xaml の SectionFg・SectionBar）。
         見出し＝色付きの小さめの太字、中身＝左に細い縦線を引いて少し字下げ -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource SectionFg}"/>
        <Setter Property="Margin" Value="0,12,0,6"/>
    </Style>
    <Style x:Key="SectionBody" TargetType="Border">
        <Setter Property="BorderThickness" Value="2,0,0,0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SectionBar}"/>
        <Setter Property="Padding" Value="12,2,0,2"/>
        <Setter Property="Margin" Value="2,0,0,4"/>
    </Style>

    <!-- 左下の設定グループ: 枠の上辺の中央に小さめの黄色い見出しを埋め込む（ーーー 形式・音質 ーーー）。色は Dark.xaml / Light.xaml の GroupFg・CardBorder・WindowBg -->
    <ui:GroupGapClipConverter x:Key="GroupGapClip"/>
    <ui:RoundClipConverter x:Key="RoundClip"/>
    <Style x:Key="GroupFrame" TargetType="GroupBox">
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <!-- 枠は、見出しの文字の部分だけ切り抜いて描く（見出しに背景を被せるのではない）。切り抜きは GroupGapClipConverter -->
                        <Border x:Name="Frame" Margin="0,9,0,0" BorderThickness="1" BorderBrush="{DynamicResource CardBorder}" Background="{DynamicResource AreaBg}"
                                CornerRadius="8" Padding="12,14,12,8">
                            <Border.Clip>
                                <MultiBinding Converter="{StaticResource GroupGapClip}">
                                    <Binding ElementName="Frame" Path="ActualWidth"/>
                                    <Binding ElementName="Frame" Path="ActualHeight"/>
                                    <Binding ElementName="Label" Path="ActualWidth"/>
                                    <Binding ElementName="Label" Path="ActualHeight"/>
                                </MultiBinding>
                            </Border.Clip>
                            <ContentPresenter/>
                        </Border>
                        <Border x:Name="Label" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,0,0,0" Padding="8,0">
                            <TextBlock Text="{TemplateBinding Header}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource GroupFg}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 入力行の小さな「FX」ボタン（11-4確認後）。テーマのボタン（影・余白が大きく、文字の下が見切れた）に頼らない、枠だけの小さな板。
         ON のときの色（青紫に光る）はコード（DeviceList.SetFxState）で変える -->
    <Style x:Key="FxButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="5" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="Transparent" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#26808080"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 入力デバイスの「使う」用。丸いランプ（ON＝緑に点灯、OFF＝消灯）。他のチェックボックスは下のトグル式 -->
    <Style x:Key="LampCheck" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" Width="22" Height="22" SnapsToDevicePixels="True">
                        <Ellipse x:Name="Lamp" Width="20" Height="20" StrokeThickness="1.5"
                                 Stroke="{DynamicResource ToggleOff}" Fill="Transparent"/>
                        <Ellipse x:Name="Ring" Width="20" Height="20" StrokeThickness="1.5" Stroke="{DynamicResource LampOnRing}"
                                 Fill="Transparent" Visibility="Collapsed">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#34D96B" BlurRadius="7" ShadowDepth="0" Opacity="0.9"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Lamp" Property="Fill" Value="{DynamicResource LampOn}"/>
                            <Setter TargetName="Lamp" Property="Stroke" Value="{DynamicResource LampOnRing}"/>
                            <Setter TargetName="Lamp" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#34D96B" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Lamp" Property="Stroke" Value="{DynamicResource LampOn}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                        <!-- 録音中などで変更できないとき: 全体は薄くなるが、ON のランプは縁だけ緑に光らせて「使っている」と分かるようにする -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Opacity" Value="1"/>
                            <Setter TargetName="Lamp" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Warn"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Lamp" Property="Fill" Value="{DynamicResource LampWarn}"/>
                            <Setter TargetName="Lamp" Property="Stroke" Value="{DynamicResource LampWarnRing}"/>
                            <Setter TargetName="Lamp" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#F0C93C" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource LampWarnRing}"/>
                            <Setter TargetName="Ring" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#F0C93C" BlurRadius="7" ShadowDepth="0" Opacity="0.9"/>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Warn"/>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Lamp" Property="Stroke" Value="{DynamicResource LampWarnRing}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Rec"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Lamp" Property="Fill" Value="{DynamicResource LampRec}"/>
                            <Setter TargetName="Lamp" Property="Opacity" Value="1"/>
                            <Setter TargetName="Lamp" Property="Stroke" Value="{DynamicResource LampRecRing}"/>
                            <Setter TargetName="Lamp" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#3DA5FF" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource LampRecRing}"/>
                            <Setter TargetName="Ring" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#3DA5FF" BlurRadius="7" ShadowDepth="0" Opacity="0.9"/>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Rec"/>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Lamp" Property="Stroke" Value="{DynamicResource LampRecRing}"/>
                        </MultiTrigger>
                        <!-- 録音中だが、ランプはOFF（出力を止めても単独録音は続いている）: 青いリングだけ光らせて「録音が動いている」と分かるようにする（M14） -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="RecOff"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource LampRecRing}"/>
                            <Setter TargetName="Ring" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#3DA5FF" BlurRadius="7" ShadowDepth="0" Opacity="0.9"/>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>
                        <!-- 赤ランプ（Tag="Error"）: ONなのに正しく使えていない（出力＝出力できない／入力＝同じデバイスの重複など）。ONのときだけ赤く点灯 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Error"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Lamp" Property="Fill" Value="{DynamicResource LampErr}"/>
                            <Setter TargetName="Lamp" Property="Stroke" Value="{DynamicResource LampErrRing}"/>
                            <Setter TargetName="Lamp" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#E53935" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource LampErrRing}"/>
                            <Setter TargetName="Ring" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#E53935" BlurRadius="7" ShadowDepth="0" Opacity="0.9"/>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>
                        <!-- 赤ランプ（Tag="Error"）がOFFのとき、マウスを乗せた輪は赤（緑ランプがOFFのときは従来どおり緑） -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Error"/>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Lamp" Property="Stroke" Value="{DynamicResource LampErrRing}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- メイン画面の出力ランプ（中に番号）。入力のランプと同じ作り（緑＝出力中、赤＝エラー、黄＝注意、青＝録音中） -->
    <Style x:Key="OutLamp" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" Width="24" Height="24" SnapsToDevicePixels="True">
                        <Ellipse x:Name="Lamp" Width="20" Height="20" StrokeThickness="1.5"
                                 Stroke="{DynamicResource ToggleOff}" Fill="Transparent"/>
                        <Ellipse x:Name="Ring" Width="20" Height="20" StrokeThickness="1.5" Stroke="{DynamicResource LampOnRing}"
                                 Fill="Transparent" Visibility="Collapsed">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#34D96B" BlurRadius="7" ShadowDepth="0" Opacity="0.9"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <ContentPresenter x:Name="Num" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontSize="11" TextElement.FontWeight="SemiBold"
                                          TextElement.Foreground="{DynamicResource WindowFg}" Opacity="0.4"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Lamp" Property="Fill" Value="{DynamicResource LampOn}"/>
                            <Setter TargetName="Num" Property="TextElement.Foreground" Value="#1B9A47"/>
                            <Setter TargetName="Num" Property="Opacity" Value="1"/>
                            <Setter TargetName="Lamp" Property="Stroke" Value="{DynamicResource LampOnRing}"/>
                            <Setter TargetName="Lamp" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#34D96B" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Lamp" Property="Stroke" Value="{DynamicResource LampOn}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                        <!-- 録音中などで変更できないとき: 全体は薄くなるが、ON のランプは縁だけ緑に光らせて「使っている」と分かるようにする -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Opacity" Value="1"/>
                            <Setter TargetName="Lamp" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Warn"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Lamp" Property="Fill" Value="{DynamicResource LampWarn}"/>
                            <Setter TargetName="Lamp" Property="Stroke" Value="{DynamicResource LampWarnRing}"/>
                            <Setter TargetName="Lamp" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#F0C93C" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource LampWarnRing}"/>
                            <Setter TargetName="Ring" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#F0C93C" BlurRadius="7" ShadowDepth="0" Opacity="0.9"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Num" Property="TextElement.Foreground" Value="#B58C0E"/>
                            <Setter TargetName="Num" Property="Opacity" Value="1"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Warn"/>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Lamp" Property="Stroke" Value="{DynamicResource LampWarnRing}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Rec"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Lamp" Property="Fill" Value="{DynamicResource LampRec}"/>
                            <Setter TargetName="Lamp" Property="Opacity" Value="1"/>
                            <Setter TargetName="Lamp" Property="Stroke" Value="{DynamicResource LampRecRing}"/>
                            <Setter TargetName="Lamp" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#3DA5FF" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource LampRecRing}"/>
                            <Setter TargetName="Ring" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#3DA5FF" BlurRadius="7" ShadowDepth="0" Opacity="0.9"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Num" Property="TextElement.Foreground" Value="#8CCBFF"/>
                            <Setter TargetName="Num" Property="Opacity" Value="1"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Rec"/>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Lamp" Property="Stroke" Value="{DynamicResource LampRecRing}"/>
                        </MultiTrigger>
                        <!-- 録音中だが、ランプはOFF（出力を止めても単独録音は続いている）: 青いリングだけ光らせて「録音が動いている」と分かるようにする（M14） -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="RecOff"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource LampRecRing}"/>
                            <Setter TargetName="Ring" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#3DA5FF" BlurRadius="7" ShadowDepth="0" Opacity="0.9"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Num" Property="TextElement.Foreground" Value="#8CCBFF"/>
                            <Setter TargetName="Num" Property="Opacity" Value="1"/>
                        </MultiTrigger>
                        <!-- 赤ランプ（Tag="Error"）: ONなのに正しく使えていない（出力＝出力できない／入力＝同じデバイスの重複など）。ONのときだけ赤く点灯 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Error"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Lamp" Property="Fill" Value="{DynamicResource LampErr}"/>
                            <Setter TargetName="Num" Property="TextElement.Foreground" Value="#FF9C9C"/>
                            <Setter TargetName="Num" Property="Opacity" Value="1"/>
                            <Setter TargetName="Lamp" Property="Stroke" Value="{DynamicResource LampErrRing}"/>
                            <Setter TargetName="Lamp" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#E53935" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource LampErrRing}"/>
                            <Setter TargetName="Ring" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#E53935" BlurRadius="7" ShadowDepth="0" Opacity="0.9"/>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>
                        <!-- 赤ランプ（Tag="Error"）がOFFのとき、マウスを乗せた輪は赤（緑ランプがOFFのときは従来どおり緑） -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Error"/>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Lamp" Property="Stroke" Value="{DynamicResource LampErrRing}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- すべてのチェックボックスを、丸いトグル式（ON＝黄色、つまみが右へ動く）にする。ライト・ダーク共通（色は Dark.xaml / Light.xaml の ToggleOn・ToggleOff・ToggleKnobOff） -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel x:Name="Root" Orientation="Horizontal" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid Width="34" Height="18" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="9" Background="{DynamicResource ToggleOff}"
                                    BorderThickness="1" BorderBrush="Transparent"/>
                            <Ellipse x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="3,0,0,0"
                                     Fill="{DynamicResource ToggleKnobOff}">
                            </Ellipse>
                        </Grid>
                        <ContentPresenter x:Name="Content" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <!-- つまみの位置は状態で即決め。スライド演出は付けない（EventTrigger＋名前指定のアニメは、作成中にIsCheckedを設定すると起動時に例外になるため。11-4確認後3で外した） -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleOn}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleKnobOn}"/>
                            <Setter TargetName="Knob" Property="Margin" Value="19,0,0,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleOn}"/>
                        </Trigger>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Content" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 右クリックメニューの既定色（テーマの読み込みに失敗したときの保険。各テーマのファイルが同じ名前で上書きする） -->
    <SolidColorBrush x:Key="MenuBg" Color="#FCFDFE"/>
    <SolidColorBrush x:Key="MenuBorder" Color="#C4CAD4"/>
    <SolidColorBrush x:Key="MenuFg" Color="#1F2430"/>
    <SolidColorBrush x:Key="MenuDisabledFg" Color="#9AA1AD"/>
    <SolidColorBrush x:Key="MenuHover" Color="#E3EDFC"/>
    <SolidColorBrush x:Key="MenuSep" Color="#D9DDE4"/>

    <!-- 右クリックメニュー（M14）。色は各テーマの MenuBg / MenuBorder / MenuFg / MenuDisabledFg / MenuHover / MenuSep（Dark.xaml・Light.xaml・Soft.xaml・SoftDark.xaml）。サブメニューは使っていないので未対応 -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource MenuFg}"/>
        <Setter Property="Background" Value="{DynamicResource MenuBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MenuBorder}"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="3" SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource MenuFg}"/>
        <Setter Property="Padding" Value="4,5,12,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="Check" Data="M1,5 L4.5,8.5 L11,1.5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <ContentPresenter ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="28,0,0,0" Opacity="0.6" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource MenuDisabledFg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Margin" Value="6,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource MenuSep}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

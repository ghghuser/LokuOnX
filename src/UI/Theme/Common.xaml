<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ★ 色の調整はここ（ライト・ダーク共通。#RRGGBB を書き換えるだけで変わります） -->
    <SolidColorBrush x:Key="IconMicFg" Color="#2AA7D8"/>        <!-- 🎤 マイク（水色） -->
    <SolidColorBrush x:Key="IconSpeakerFg" Color="#F08A4B"/>    <!-- 🔊 スピーカー（橙） -->
    <SolidColorBrush x:Key="IconAsioFg" Color="#9B6BE8"/>       <!-- 🎛 ASIO（紫） -->
    <SolidColorBrush x:Key="DefaultMarkFg" Color="#CC3D8C"/>    <!-- 既定のデバイスの ＊（赤紫） -->
    <SolidColorBrush x:Key="LampOn" Color="#34D96B"/>           <!-- 入力デバイスの「使う」ランプ（緑） -->

    <!-- 設定の「見出し」と「中身」を見分けやすくする共通スタイル（ライト・ダーク共通。色は Dark.xaml / Light.xaml の SectionFg・SectionBar）。
         見出し＝色付きの小さめの太字、中身＝左に細い縦線を引いて少し字下げ -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource SectionFg}"/>
        <Setter Property="Margin" Value="0,12,0,6"/>
    </Style>
    <Style x:Key="SectionBody" TargetType="Border">
        <Setter Property="BorderThickness" Value="2,0,0,0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SectionBar}"/>
        <Setter Property="Padding" Value="12,2,0,2"/>
        <Setter Property="Margin" Value="2,0,0,4"/>
    </Style>

    <!-- 左下の設定グループ: 枠の上辺の中央に小さめの黄色い見出しを埋め込む（ーーー 形式・音質 ーーー）。色は Dark.xaml / Light.xaml の GroupFg・CardBorder・WindowBg -->
    <Style x:Key="GroupFrame" TargetType="GroupBox">
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Border Margin="0,9,0,0" BorderThickness="1" BorderBrush="{DynamicResource CardBorder}"
                                CornerRadius="8" Padding="12,14,12,8">
                            <ContentPresenter/>
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,0,0,0" Padding="8,0"
                                Background="{DynamicResource WindowBg}">
                            <TextBlock Text="{TemplateBinding Header}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource GroupFg}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 入力デバイスの「使う」用。丸いランプ（ON＝緑に点灯、OFF＝消灯）。他のチェックボックスは下のトグル式 -->
    <Style x:Key="LampCheck" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" Width="20" Height="20" SnapsToDevicePixels="True">
                        <Ellipse x:Name="Lamp" Width="14" Height="14" StrokeThickness="1.5"
                                 Stroke="{DynamicResource ToggleOff}" Fill="Transparent"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Lamp" Property="Fill" Value="{DynamicResource LampOn}"/>
                            <Setter TargetName="Lamp" Property="Stroke" Value="{DynamicResource LampOn}"/>
                            <Setter TargetName="Lamp" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#34D96B" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Lamp" Property="Stroke" Value="{DynamicResource LampOn}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- すべてのチェックボックスを、丸いトグル式（ON＝黄色、つまみが右へ動く）にする。ライト・ダーク共通（色は Dark.xaml / Light.xaml の ToggleOn・ToggleOff・ToggleKnobOff） -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel x:Name="Root" Orientation="Horizontal" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid Width="34" Height="18" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="9" Background="{DynamicResource ToggleOff}"
                                    BorderThickness="1" BorderBrush="Transparent"/>
                            <Ellipse x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="3,0,0,0"
                                     Fill="{DynamicResource ToggleKnobOff}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobMove" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ContentPresenter x:Name="Content" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleOn}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleKnobOn}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleOn}"/>
                        </Trigger>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Content" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ライト用のボタン（Windows 標準の灰色より明るい、ほぼ白の面＋細い枠）。色はこのファイルで調整できます。ニューモーフィズム・ライトは SoftControls.xaml が上書きします -->
    <SolidColorBrush x:Key="LightBtnFace" Color="#FDFDFE"/>
    <SolidColorBrush x:Key="LightBtnHover" Color="#EEF3FB"/>
    <SolidColorBrush x:Key="LightBtnPressed" Color="#DCE6F5"/>
    <SolidColorBrush x:Key="LightBtnBorder" Color="#C3CAD4"/>

    <ControlTemplate x:Key="LightButtonTemplate" TargetType="ButtonBase">
        <Border x:Name="Bd" Background="{StaticResource LightBtnFace}" BorderBrush="{StaticResource LightBtnBorder}"
                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LightBtnHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LightBtnPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#8A8F98"/>
                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="Button">
        <Setter Property="Template" Value="{StaticResource LightButtonTemplate}"/>
    </Style>
    <Style TargetType="RepeatButton">
        <Setter Property="Template" Value="{StaticResource LightButtonTemplate}"/>
    </Style>
</ResourceDictionary>

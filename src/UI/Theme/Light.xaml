<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ライト: Windows 標準の見た目のまま。ウィンドウの色だけ、ダークと同じキーで用意する -->
    <SolidColorBrush x:Key="WindowBg" Color="#F7F8FA"/>
    <!-- スクロールバーのつまみ（通常／マウスを乗せた／つかんだ）。色はここで調整 -->
    <!-- スライダー・ラジオボタン（LightSlider.xaml）: 溝／つまみの輪／つまみの縁 -->
    <SolidColorBrush x:Key="TrackBg" Color="#C5CBD6"/>
    <SolidColorBrush x:Key="ThumbRing" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ThumbStroke" Color="#8A9BB5"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#40000000"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#70000000"/>
    <SolidColorBrush x:Key="ScrollThumbDrag" Color="#C02F80ED"/>
    <SolidColorBrush x:Key="LogBg" Color="#10000000"/>   <!-- 一番下のログ欄の背景（ライト系はダークより明るめ） -->
    <SolidColorBrush x:Key="AreaBg" Color="#5EFFFFFF"/>   <!-- 形式・音質／下のタブの中身／プレーヤーの面（入力デバイスのカード CardBg より透け強め） -->
    <SolidColorBrush x:Key="WindowFg" Color="{x:Static SystemColors.ControlTextColor}"/>
    <SolidColorBrush x:Key="LinkOff" Color="#16000000"/>      <!-- 「録音に含める」の線: 含めないとき（薄い線。白に近く） -->
    <SolidColorBrush x:Key="LinkStop" Color="#2B2B2B"/>       <!-- 「録音に含める」がオンなのに出力が止まっているとき（ライト系は黒っぽく。黄の注意と区別） -->
    <SolidColorBrush x:Key="CautionFg" Color="#E8A400"/>   <!-- 注意の黄（ライト系2種。11-4確認後に原色寄りへ。白い背景で読める範囲の強い黄） -->
    <SolidColorBrush x:Key="WarnFg" Color="#E60000"/>      <!-- エラー・注意の赤（ライト系2種。11-4確認後に原色寄りへ。ダーク系は Common.xaml の色のまま） -->
    <!-- プルダウン・タブ用（ウィンドウの標準色になじむ、ごくわずかに明るい面と、やわらかい青みの強調） -->
    <SolidColorBrush x:Key="PanelBg" Color="#F8F9FB"/>
    <SolidColorBrush x:Key="PanelHover" Color="#E6ECF5"/>
    <SolidColorBrush x:Key="PanelBorder" Color="#BCC3CE"/>
    <!-- 右クリックメニュー（M14）。Common.xaml の ContextMenu／MenuItem がこの色を使う -->
    <SolidColorBrush x:Key="MenuBg" Color="#FCFDFE"/>   <!-- メニューの背景 -->
    <SolidColorBrush x:Key="MenuBorder" Color="#C4CAD4"/>   <!-- 枠 -->
    <SolidColorBrush x:Key="MenuFg" Color="#1F2430"/>   <!-- 文字 -->
    <SolidColorBrush x:Key="MenuDisabledFg" Color="#9AA1AD"/>   <!-- 無効の文字 -->
    <SolidColorBrush x:Key="MenuHover" Color="#E3EDFC"/>   <!-- 選択中の行 -->
    <SolidColorBrush x:Key="MenuSep" Color="#D9DDE4"/>   <!-- 区切り線 -->
    <SolidColorBrush x:Key="PopupBg" Color="#FBFCFD"/>
    <SolidColorBrush x:Key="PastelDim" Color="#D6E4F7"/>
    <SolidColorBrush x:Key="Pastel" Color="#2F80ED"/>
    <SolidColorBrush x:Key="DisabledFg" Color="#6B7079"/>
    <SolidColorBrush x:Key="TabSelBg" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="LampOnRing" Color="#23AC52"/>   <!-- 点灯時の輪（緑の面より濃くして、はっきり見せる） -->
    <SolidColorBrush x:Key="NewFileFg" Color="#1565C0"/>
    <SolidColorBrush x:Key="OldFileFg" Color="{x:Static SystemColors.ControlTextColor}"/>
    <SolidColorBrush x:Key="MarkFg" Color="#5F6368"/>
    <SolidColorBrush x:Key="CardBg" Color="#70FFFFFF"/>   <!-- 上段のカード。背景より少し白く浮かせる（半透明） -->
    <SolidColorBrush x:Key="CardBorder" Color="#80D0D0D0"/>
    <SolidColorBrush x:Key="InputBg" Color="#FFFFFF"/>   <!-- 入力欄（TextBox）と同じ背景。ファイル一覧・プロファイル欄が使う -->
    <SolidColorBrush x:Key="LaneBg" Color="#0A000000"/>
    <SolidColorBrush x:Key="MeterBg" Color="#12000000"/>
    <SolidColorBrush x:Key="WaveBg" Color="#151A24"/>   <!-- 波形欄は暗い背景（波形の水色が読める。ソフトと同じ） -->
    <SolidColorBrush x:Key="WaveBgOff" Color="#10141C"/>
    <SolidColorBrush x:Key="WaveBorder" Color="#2B3344"/>
    <SolidColorBrush x:Key="LaneBorder" Color="#CFCFCF"/>
    <SolidColorBrush x:Key="StartFg" Color="#1E5A36"/>
    <SolidColorBrush x:Key="StopFg" Color="#1D4580"/>
    <SolidColorBrush x:Key="RecDot" Color="#C94A86"/>
    <SolidColorBrush x:Key="SectionFg" Color="#1A5FB4"/>
    <SolidColorBrush x:Key="SectionBar" Color="#9DB9E0"/>
    <SolidColorBrush x:Key="ScheduleOnFg" Color="#B34700"/>
    <SolidColorBrush x:Key="ScheduleOnBg" Color="#FFD9B0"/>
    <SolidColorBrush x:Key="GroupFg" Color="#2A63B8"/>
    <!-- チェックボックス（丸いトグル式）。ON＝青 -->
    <SolidColorBrush x:Key="ToggleOn" Color="#2F80ED"/>
    <SolidColorBrush x:Key="ToggleOff" Color="#B9BEC5"/>
    <SolidColorBrush x:Key="ToggleKnobOff" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToggleKnobOn" Color="#FFFFFF"/>
    <!-- 無効（グレーアウト）のラジオボタンは、文字も丸印もかなり薄くする（ダークは DarkControls.xaml） -->
    <!-- ツールチップ: ダークと同じく、透けない面（PopupBg）で読みやすく -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource PopupBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>

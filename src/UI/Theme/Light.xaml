<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ライト: Windows 標準の見た目のまま。ウィンドウの色だけ、ダークと同じキーで用意する -->
    <SolidColorBrush x:Key="WindowBg" Color="{x:Static SystemColors.ControlColor}"/>
    <SolidColorBrush x:Key="WindowFg" Color="{x:Static SystemColors.ControlTextColor}"/>
    <!-- プルダウン・タブ用（ウィンドウの標準色になじむ、ごくわずかに明るい面と、やわらかい青みの強調） -->
    <SolidColorBrush x:Key="PanelBg" Color="#F8F9FB"/>
    <SolidColorBrush x:Key="PanelHover" Color="#E6ECF5"/>
    <SolidColorBrush x:Key="PanelBorder" Color="#BCC3CE"/>
    <SolidColorBrush x:Key="PopupBg" Color="#FBFCFD"/>
    <SolidColorBrush x:Key="PastelDim" Color="#D6E4F7"/>
    <SolidColorBrush x:Key="Pastel" Color="#E3B400"/>
    <SolidColorBrush x:Key="DisabledFg" Color="#6B7079"/>
    <SolidColorBrush x:Key="TabSelBg" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="NewFileFg" Color="#1565C0"/>
    <SolidColorBrush x:Key="OldFileFg" Color="{x:Static SystemColors.ControlTextColor}"/>
    <SolidColorBrush x:Key="MarkFg" Color="#5F6368"/>
    <SolidColorBrush x:Key="CardBg" Color="#0C000000"/>
    <SolidColorBrush x:Key="CardBorder" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="LaneBg" Color="#10000000"/>
    <SolidColorBrush x:Key="LaneBorder" Color="#CFCFCF"/>
    <SolidColorBrush x:Key="StartFg" Color="#1E5A36"/>
    <SolidColorBrush x:Key="StopFg" Color="#1D4580"/>
    <SolidColorBrush x:Key="RecDot" Color="#C94A86"/>
    <SolidColorBrush x:Key="SectionFg" Color="#1A5FB4"/>
    <SolidColorBrush x:Key="SectionBar" Color="#9DB9E0"/>
    <SolidColorBrush x:Key="ScheduleOnFg" Color="#B34700"/>
    <SolidColorBrush x:Key="ScheduleOnBg" Color="#FFD9B0"/>
    <SolidColorBrush x:Key="GroupFg" Color="#8A6D00"/>
    <!-- チェックボックス（丸いトグル式）。ON＝明るい青緑 -->
    <SolidColorBrush x:Key="ToggleOn" Color="#E3B400"/>
    <SolidColorBrush x:Key="ToggleOff" Color="#B9BEC5"/>
    <SolidColorBrush x:Key="ToggleKnobOff" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToggleKnobOn" Color="#FFFFFF"/>
    <!-- 無効（グレーアウト）のラジオボタンは、文字も丸印もかなり薄くする（ダークは DarkControls.xaml） -->
    <Style TargetType="RadioButton">
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>

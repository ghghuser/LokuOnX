<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ソフト（ダーク）: ダークの色を、半透明をやめた不透明のやわらかい面に差し替える（ニューモーフィズム風。文字は明るいまま）。
         影の色だけは SoftControlsDark.xaml の DropShadowEffect に直接書いてある -->
    <SolidColorBrush x:Key="WindowBg" Color="#282B31"/>
    <SolidColorBrush x:Key="AreaBg" Color="#4E282B31"/>   <!-- 形式・音質／下のタブの中身／プレーヤーの面（入力デバイスのカード CardBg より透け強め） -->
    <!-- スクロールバーのつまみ（通常／マウスを乗せた／つかんだ）。色はここで調整 -->
    <SolidColorBrush x:Key="ScrollThumb" Color="#50FFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbDrag" Color="#B0F3DD8A"/>
    <SolidColorBrush x:Key="PanelBg" Color="#282B31"/>
    <SolidColorBrush x:Key="PopupBg" Color="#2E3239"/>
    <SolidColorBrush x:Key="PanelHover" Color="#32363E"/>
    <SolidColorBrush x:Key="CardBg" Color="#2C3036"/>
    <SolidColorBrush x:Key="CardBorder" Color="#703A3F47"/>
    <SolidColorBrush x:Key="InputBg" Color="#1E2126"/>   <!-- 入力欄（TextBox）と同じ背景。ファイル一覧・プロファイル欄が使う -->
    <SolidColorBrush x:Key="LaneBg" Color="#1E2126"/>
    <SolidColorBrush x:Key="MeterBg" Color="#1A1D21"/>
    <SolidColorBrush x:Key="LaneBorder" Color="#181A1E"/>
    <SolidColorBrush x:Key="PanelBorder" Color="#3A3F47"/>
    <!-- 右クリックメニュー（M14）。Common.xaml の ContextMenu／MenuItem がこの色を使う -->
    <SolidColorBrush x:Key="MenuBg" Color="#2C3036"/>   <!-- メニューの背景 -->
    <SolidColorBrush x:Key="MenuBorder" Color="#3F454D"/>   <!-- 枠 -->
    <SolidColorBrush x:Key="MenuHover" Color="#3A404B"/>   <!-- 選択中の行 -->
    <SolidColorBrush x:Key="SoftFace" Color="#282B31"/>
    <SolidColorBrush x:Key="SoftFaceHover" Color="#2F333A"/>
    <SolidColorBrush x:Key="SoftFacePressed" Color="#22252A"/>
    <SolidColorBrush x:Key="SoftDisabledFg" Color="#6F737A"/>
</ResourceDictionary>

<Window x:Class="Recorder.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Recorder.UI"
        Icon="pack://application:,,,/app.ico"
        Title="LokuOnX"
        Width="1200" Height="820"
        MinWidth="1000" MinHeight="700"
        FontFamily="Yu Gothic UI, Meiryo UI"
        FontSize="14"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 上段: メジャーな設定（常時表示） -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="入力デバイス" VerticalAlignment="Center"/>
            <ComboBox x:Name="DeviceBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,6"
                      DisplayMemberPath="DisplayLabel" SelectionChanged="DeviceBox_SelectionChanged"/>
            <Button x:Name="RefreshButton" Grid.Row="0" Grid.Column="2" Content="一覧を更新"
                    Margin="0,0,0,6" Padding="12,3" Click="Refresh_Click"/>

            <TextBlock Grid.Row="1" Text="形式・音質" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,6">
                <ComboBox x:Name="FormatBox" Width="140" Margin="0,0,18,0"
                          DisplayMemberPath="Label" SelectedValuePath="Key"
                          SelectionChanged="FormatBox_SelectionChanged"/>
                <ui:QualityBar x:Name="Quality" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="保存先" VerticalAlignment="Center"/>
            <TextBox x:Name="FolderBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,6"
                     VerticalContentAlignment="Center" LostFocus="FolderBox_LostFocus"/>
            <Button x:Name="BrowseButton" Grid.Row="2" Grid.Column="2" Content="参照..."
                    Margin="0,0,0,6" Padding="12,3" Click="Browse_Click"/>

            <TextBlock Grid.Row="3" Text="自動分割" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,6">
                <TextBox x:Name="SplitBox" Width="60" VerticalContentAlignment="Center"
                         ToolTip="0 のときは自動分割しません（1つのファイルは最長24時間で必ず分割されます）"
                         LostFocus="Split_LostFocus"/>
                <TextBlock Text="分ごとに分割（0＝しない。1つのファイルは最長24時間）" VerticalAlignment="Center"
                           Margin="8,0,0,0" Opacity="0.75"/>
            </StackPanel>

        </Grid>

        <!-- ファイル名・番号（常時表示）と、折りたたみ（日付フォルダ・タグ） -->
        <StackPanel Grid.Row="1" Margin="0,4,0,0">
            <ui:DetailPanel x:Name="Detail"/>
            <Expander x:Name="ExpOption" Header="オプション">
                <TextBlock Margin="16,6,0,6" Opacity="0.7" Text="オプションは M7 以降で追加します（無音検出など）。"/>
            </Expander>
        </StackPanel>

        <!-- 中段: 経過時間・メーター -->
        <Border Grid.Row="2" Margin="0,12,0,12" BorderBrush="#40808080" BorderThickness="1" CornerRadius="4" Padding="16">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="TimeText" Text="0：00：00" FontSize="40" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalText" FontSize="20" Opacity="0.75" Margin="14,0,0,5"
                               VerticalAlignment="Bottom"
                               ToolTip="録音を始めてからの連続録音時間（分割しても続きます）"/>
                </StackPanel>
                <TextBlock x:Name="StateText" Text="待機中" HorizontalAlignment="Center" Opacity="0.75"/>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="音量" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ProgressBar x:Name="Meter" Grid.Column="1" Height="22" Minimum="0" Maximum="1"
                                 Foreground="#2E9E4F"/>
                    <TextBlock x:Name="PeakText" Grid.Column="2" Margin="10,0,0,0"
                               Foreground="#D33" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 録音ボタン -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="StartButton" Content="● 録音開始" Padding="22,8" FontWeight="SemiBold"
                    Click="Start_Click"/>
            <Button x:Name="PauseButton" Content="一時停止" Padding="22,8" Margin="8,0,0,0"
                    IsEnabled="False" Click="Pause_Click"/>
            <Button x:Name="SplitButton" Content="分割" Padding="22,8" Margin="8,0,0,0"
                    IsEnabled="False" ToolTip="途切れずに次のファイルへ切り替えます" Click="Split_Click"/>
            <Button x:Name="StopButton" Content="■ 停止" Padding="22,8" Margin="8,0,0,0"
                    IsEnabled="False" Click="Stop_Click"/>
        </StackPanel>

        <!-- 下段: 状態表示（ファイル一覧とプレイヤーは M6） -->
        <TextBox x:Name="StatusText" Grid.Row="4" Margin="0,10,0,0" IsReadOnly="True"
                 BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                 Text="待機中"/>
    </Grid>
</Window>

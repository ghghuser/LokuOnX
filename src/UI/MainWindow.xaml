<Window x:Class="Recorder.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Recorder.UI"
        Icon="pack://application:,,,/LokuOnX.ico"
        Title="LokuOnX"
        Width="1280" Height="900"
        MinWidth="1000" MinHeight="760"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource WindowFg}"
        FontFamily="Yu Gothic UI, Meiryo UI"
        FontSize="14"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="700" MinWidth="560"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="380"/>
        </Grid.ColumnDefinitions>

        <!-- 左: 設定・録音・波形・状態 -->
        <Grid Grid.Column="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 上段: メジャーな設定（常時表示） -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="プリセット" VerticalAlignment="Center"/>
            <ui:PresetBar x:Name="Presets" Grid.Row="0" Grid.Column="1" Margin="0,0,8,4"/>
            <Button x:Name="SettingsButton" Grid.Row="0" Grid.Column="2" Content="⚙" FontFamily="Segoe UI Symbol"
                    FontSize="17" Width="34" Height="28" Padding="0" VerticalAlignment="Top" Margin="0,0,0,4"
                    ToolTip="設定とヘルプ（画面の色・スリープ防止・バージョン情報）" Click="Settings_Click"/>

            <TextBlock Grid.Row="1" Text="入力デバイス" VerticalAlignment="Top" Margin="0,4,0,0"/>
            <ui:DeviceList x:Name="Devices" Grid.Row="1" Grid.Column="1" Margin="0,0,8,2"/>
            <Button x:Name="RefreshButton" Grid.Row="1" Grid.Column="2" Content="一覧を更新"
                    VerticalAlignment="Top" Margin="0,0,0,6" Padding="12,3" Click="Refresh_Click"/>

            <TextBlock Grid.Row="2" Text="形式・音質" VerticalAlignment="Top" Margin="0,4,0,0"/>
            <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,8,4" LastChildFill="True">
                <ComboBox x:Name="FormatBox" Width="140" Margin="0,0,18,0" DockPanel.Dock="Left"
                          VerticalAlignment="Top"
                          DisplayMemberPath="Label" SelectedValuePath="Key"
                          SelectionChanged="FormatBox_SelectionChanged"/>
                <ui:QualityBar x:Name="Quality" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock Grid.Row="3" Text="保存先" VerticalAlignment="Center"/>
            <TextBox x:Name="FolderBox" Grid.Row="3" Grid.Column="1" Margin="0,0,8,6"
                     VerticalContentAlignment="Center" LostFocus="FolderBox_LostFocus"/>
            <Button x:Name="BrowseButton" Grid.Row="3" Grid.Column="2" Content="参照..."
                    Margin="0,0,0,6" Padding="12,3" Click="Browse_Click"/>

            <TextBlock Grid.Row="4" Text="自動分割" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,6">
                <ui:TimeBox x:Name="SplitBox" Width="70"
                         ToolTip="時:分:秒。00:00:00 は自動分割しません。最短 00:00:10、最長 24:00:00（1つのファイルは最長24時間で必ず分割されます）。▲▼ はカーソルのある桁を ±1（↑↓キーも可）"
                         LostFocus="Split_LostFocus"/>
                <TextBlock Text="(0＝無効。最長24時間)" VerticalAlignment="Center"
                           Margin="8,0,0,0" Opacity="0.75"/>
            </StackPanel>

        </Grid>

        <!-- ファイル名・番号（常時表示）と、折りたたみ（日付フォルダ・タグ） -->
        <StackPanel Grid.Row="1" Margin="0,4,0,0">
            <ui:DetailPanel x:Name="Detail"/>
            <Expander x:Name="ExpOption" Header="オプション">
                <TextBlock Margin="16,6,0,6" Opacity="0.7" Text="オプションは M7 以降で追加します（無音検出など）。"/>
            </Expander>
        </StackPanel>

        <!-- 中段: 経過時間・メーター・波形 -->
        <Border Grid.Row="2" Margin="0,12,0,12" BorderBrush="#40808080" BorderThickness="1" CornerRadius="4" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="TimeText" Text="0：00：00" FontSize="40" FontWeight="SemiBold"/>
                    <StackPanel x:Name="TotalPanel" Margin="18,0,0,3" VerticalAlignment="Bottom" Visibility="Collapsed"
                                ToolTip="録音を始めてからの連続録音時間（分割しても続きます）">
                        <TextBlock Text="Total Time" FontSize="12" Opacity="0.75"/>
                        <TextBlock x:Name="TotalText" FontSize="20" Opacity="0.85"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Row="1" x:Name="StateText" Text="待機中" HorizontalAlignment="Center" Opacity="0.75"/>
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="音量" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ProgressBar x:Name="Meter" Grid.Column="1" Height="22" Minimum="0" Maximum="1"
                                 Foreground="#2E9E4F"/>
                    <TextBlock x:Name="PeakText" Grid.Column="2" Margin="10,0,0,0"
                               Foreground="#D33" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
                <ui:WaveView x:Name="Wave" Grid.Row="3" Margin="0,12,0,0" MinHeight="70" ClipToBounds="True"/>
            </Grid>
        </Border>

        <!-- 録音ボタン -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="StartButton" Content="● 録音開始" Padding="22,8" FontWeight="SemiBold"
                    Click="Start_Click"/>
            <Button x:Name="PauseButton" Content="一時停止" Padding="22,8" Margin="8,0,0,0"
                    IsEnabled="False" Click="Pause_Click"/>
            <Button x:Name="SplitButton" Content="分割" Padding="22,8" Margin="8,0,0,0"
                    IsEnabled="False" ToolTip="途切れずに次のファイルへ切り替えます" Click="Split_Click"/>
            <Button x:Name="StopButton" Content="■ 停止" Padding="22,8" Margin="8,0,0,0"
                    IsEnabled="False" Click="Stop_Click"/>
        </StackPanel>

        <!-- 下段: 状態表示 -->
        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#D33" FontWeight="SemiBold" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,0,0,4"/>
            <TextBox x:Name="StatusText" IsReadOnly="True"
                     BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                     Text="待機中"/>
        </StackPanel>

        </Grid>

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="Transparent" ShowsPreview="False" ResizeBehavior="PreviousAndNext"
                      ToolTip="ドラッグで左右の幅を変えられます"/>

        <!-- 右: ファイル一覧とプレイヤー -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ui:FileListPanel x:Name="Files" Grid.Row="0"/>
            <ui:PlayerPanel x:Name="Player" Grid.Row="1" Margin="0,8,0,0"/>
        </Grid>
    </Grid>
</Window>

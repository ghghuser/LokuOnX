<Window x:Class="Recorder.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Recorder.UI"
        Icon="pack://application:,,,/LokuOnX.ico"
        Title="LokuOnX"
        Width="1280" Height="940"
        MinWidth="1180" MinHeight="800"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource WindowFg}"
        FontFamily="Yu Gothic UI, Meiryo UI"
        FontSize="14"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="610"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 「インジケーター(常時)」のチェックは、起動時に入力デバイス欄の下の行（デバイス再取得の左）へ移す -->
        <Border x:Name="CheckHolder" Grid.Row="0" Visibility="Collapsed">
            <CheckBox x:Name="InputCheckBox" Content="{ui:T mainwindow.inputcheckbox.content}" FontSize="12"
                                  ToolTip="{ui:T mainwindow.inputcheckbox.tooltip}"
                                  Checked="InputCheck_Changed" Unchecked="InputCheck_Changed"/>
        </Border>

        <!-- 最上段: プロファイル ｜ ログ（保存しました など。常に2行分の高さ） ｜ 設定の歯車 -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{ui:T mainwindow.textblock1.text}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ui:ProfileBar x:Name="Profiles"/>
            </StackPanel>
            <!-- 予約録音が有効なとき、次の予約を目立つ色で出す -->
            <Border x:Name="ScheduleBadge" Grid.Column="2" Visibility="Collapsed" CornerRadius="11" Padding="11,3" Margin="0,0,10,0"
                    VerticalAlignment="Center" Background="{DynamicResource ScheduleOnBg}"
                    ToolTip="{ui:T mainwindow.schedulebadge.tooltip}">
                <TextBlock x:Name="ScheduleBadgeText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ScheduleOnFg}"/>
            </Border>
            <!-- 出力（M11-2）: 出力ウィンドウを開く。出力中は色が変わる -->
            <Button x:Name="OutputButton" Grid.Column="3" Content="⇶" FontFamily="Segoe UI Symbol"
                    FontSize="16" MinWidth="34" Height="28" Padding="6,0" Margin="0,0,6,0" VerticalAlignment="Center"
                    ToolTip="{ui:T mainwindow.outputbutton.tooltip}" Click="Output_Click"
                    PreviewMouseRightButtonUp="Output_RightClick"/>
            <Button x:Name="SettingsButton" Grid.Column="4" Content="⚙" FontFamily="Segoe UI Symbol"
                    FontSize="17" Width="34" Height="28" Padding="0" VerticalAlignment="Center"
                    ToolTip="{ui:T mainwindow.settingsbutton.tooltip}" Click="Settings_Click"/>
        </Grid>

        <!-- 録音コンソール: 左＝時間・メーター・録音ボタン、右＝入力デバイスのストリップ（選択・波形・ゲイン・レベル） -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,12" Padding="18,14" CornerRadius="10" BorderThickness="1"
                Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TimeText" Text="0:00:00" FontSize="40"
                                   FontFamily="Bahnschrift, Consolas, Yu Gothic UI" Typography.NumeralAlignment="Tabular"/>
                        <StackPanel x:Name="TotalPanel" Margin="16,0,0,4" VerticalAlignment="Bottom" Visibility="Collapsed"
                                    ToolTip="{ui:T mainwindow.totalpanel.tooltip}">
                            <TextBlock Text="Total Time" FontSize="12" Opacity="0.75"/>
                            <TextBlock x:Name="TotalText" FontSize="20" Opacity="0.9"
                                       FontFamily="Bahnschrift, Consolas, Yu Gothic UI" Typography.NumeralAlignment="Tabular"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock x:Name="StateText" Text="{ui:T mainwindow.statetext.text}" Opacity="0.7" Margin="2,0,0,0" VerticalAlignment="Center"/>

                    </Grid>
                    <!-- 全体波形（録音する音全体。右端が最新） -->
                    <ui:BigWave x:Name="OverallWave" Margin="0,0,0,10"
                                ToolTip="{ui:T mainwindow.overallwave.tooltip}"/>

                    <!-- 出力レベルと全体ゲインの融合メーター: L・R と dB の目盛り。白い線＝最大値、右端＝クリップ、縦長のつまみ＝全体ゲイン -->
                    <ui:OutputMeter x:Name="OutMeter" Margin="2,0,0,12"/>

                    <!-- 録音・一時停止・分割を同じ行に（録音ボタンは開始と停止を兼ねるトグル） -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StartButton" Height="46" FontSize="16" FontWeight="SemiBold"
                                ToolTip="{ui:T mainwindow.startbutton.tooltip}"
                                Click="Start_Click"/>
                        <Button x:Name="PauseButton" Grid.Column="2" Height="46" MinWidth="96" Padding="10,0" FontSize="13"
                                IsEnabled="False" Click="Pause_Click"/>
                        <Button x:Name="SplitButton" Grid.Column="4" Height="46" MinWidth="78" Padding="10,0" FontSize="13"
                                IsEnabled="False" ToolTip="{ui:T mainwindow.splitbutton.tooltip}" Click="Split_Click">
                            <TextBlock><Run FontFamily="Segoe UI Symbol" Text="✂"/><Run Text="{ui:T mainwindow.run1.text}"/></TextBlock>
                        </Button>
                    </Grid>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Margin="18,2" Fill="{DynamicResource CardBorder}"/>

                <ui:DeviceList x:Name="Devices" Grid.Column="0"/>
            </Grid>
        </Border>

        <TextBlock x:Name="ErrorText" Grid.Row="2" Grid.ColumnSpan="3" Foreground="{DynamicResource WarnFg}" FontWeight="SemiBold"
                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8"/>

        <!-- 左下: 設定（縦に長いときはスクロール）。「形式・音質」「保存先・ファイル名」は枠で囲み、その下にタブ -->
        <ScrollViewer Grid.Row="3" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <GroupBox Header="{ui:T mainwindow.groupbox1.header}" Style="{StaticResource GroupFrame}">
                    <ui:QualityBar x:Name="Quality"/>
                </GroupBox>

                <TabControl x:Name="LowerTabs">
                    <TabItem Header="{ui:T mainwindow.tabitem1.header}">
                        <!-- 項目名の列（FormLabel）は、保存先と下の DetailPanel でそろえる -->
                        <StackPanel Margin="2,8,0,6" Grid.IsSharedSizeScope="True">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="FormLabel"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{ui:T mainwindow.textblock2.text}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="FolderBox" Grid.Column="1" Margin="0,0,8,0"
                                         VerticalContentAlignment="Center" LostFocus="FolderBox_LostFocus"/>
                                <Button x:Name="BrowseButton" Grid.Column="2" Content="{ui:T mainwindow.browsebutton.content}"
                                        Padding="12,3" Click="Browse_Click"/>
                            </Grid>
                            <ui:DetailPanel x:Name="Detail"/>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="{ui:T mainwindow.tabitem2.header}">
                        <ui:TagPanel x:Name="TagsTab" Margin="2,0,0,6"/>
                    </TabItem>
                    <TabItem Header="{ui:T mainwindow.tabitem3.header}">
                        <StackPanel Margin="2,0,0,4">
                            <TextBlock Text="{ui:T mainwindow.textblock3.text}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                            <Border Style="{StaticResource SectionBody}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:TimeBox x:Name="SplitBox" Width="70"
                                                ToolTip="{ui:T mainwindow.splitbox.tooltip}"
                                                LostFocus="Split_LostFocus"/>
                                    <TextBlock Text="{ui:T mainwindow.textblock4.text}" VerticalAlignment="Center"
                                               Margin="8,0,0,0" Opacity="0.75"/>
                                </StackPanel>
                            </Border>
                            <ui:OptionPanel x:Name="Options"/>
                            <ui:SchedulePanel x:Name="Plans"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>

        <!-- 右下: 録音履歴（ファイル一覧）・プレイヤー・ファイル操作 -->
        <ui:FileListPanel x:Name="Files" Grid.Row="3" Grid.Column="2"/>

        <!-- 左下: ログ（保存しました など。常に2行分の高さ）。枠で囲み、ホットキー表示の上に置く -->
        <Border Grid.Row="4" Grid.Column="0" Margin="0,8,10,0" Padding="10,4" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource CardBorder}">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight" Height="32"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Opacity="0.85" Text="{ui:T mainwindow.statustext.text}"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Border>

        <!-- ウィンドウの一番下: ホットキーがONのとき、割り当てを薄い文字で（設定は歯車の設定ウィンドウ） -->
        <TextBlock x:Name="HotkeyInfo" Grid.Row="5" Grid.ColumnSpan="3" FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                   Margin="2,8,0,0" Visibility="Collapsed"/>
    </Grid>
</Window>

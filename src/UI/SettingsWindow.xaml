<Window x:Class="Recorder.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Recorder.UI"
        Title="{ui:T settings.title}" Width="620" Height="720" MinWidth="520" MinHeight="420"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource WindowFg}"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="14"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize">
    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs">
            <!-- 詳細設定: めったに使わない設定。見出し（色付き）と中身（左に縦線）で見分ける -->
            <TabItem Header="{ui:T settings.tab.advanced}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" FontSize="13">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="{ui:T settings.section.display}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource SectionBody}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{ui:T settings.language}" Width="72" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="LangBox" Width="220" DisplayMemberPath="Name" SelectedValuePath="Code"
                                              ToolTip="{ui:T settings.language.tip}"
                                              SelectionChanged="Lang_Changed"/>
                                </StackPanel>
                                <TextBlock x:Name="LangNote" Text="{ui:T settings.language.restart}" Visibility="Collapsed"
                                           FontSize="12" Opacity="0.65" Margin="80,4,0,0" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{ui:T settings.theme}" Width="72" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="ThemeBox" Width="220" DisplayMemberPath="Label" SelectedValuePath="Key"
                                              ToolTip="{ui:T settings.theme.tip}"
                                              SelectionChanged="Theme_Changed"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{ui:T settings.section.recording}" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource SectionBody}">
                            <StackPanel>
                                <CheckBox x:Name="SleepCheck" Content="{ui:T settings.sleep}" Margin="0,0,0,10"
                                          Checked="Sleep_Changed" Unchecked="Sleep_Changed"/>
                                <TextBlock Text="{ui:T settings.lost.heading}" FontSize="12" Opacity="0.65" Margin="0,0,0,4"/>
                                <CheckBox x:Name="WaitCheck" Content="{ui:T settings.lost.wait}" Margin="0,0,0,4"
                                          ToolTip="{ui:T settings.lost.wait.tip}"
                                          Checked="Device_Changed" Unchecked="Device_Changed"/>
                                <CheckBox x:Name="SplitReturnCheck" Content="{ui:T settings.lost.split}"
                                          ToolTip="{ui:T settings.lost.split.tip}"
                                          Checked="Device_Changed" Unchecked="Device_Changed"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{ui:T settings.section.asio}" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource SectionBody}">
                            <StackPanel>
                                <CheckBox x:Name="AsioCheck" Content="{ui:T settings.asio}"
                                          ToolTip="{ui:T settings.asio.tip}"
                                          Checked="Asio_Changed" Unchecked="Asio_Changed"/>
                                <TextBlock Text="{ui:T settings.asio.note}"
                                           TextWrapping="Wrap" FontSize="12" Opacity="0.65" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{ui:T settings.section.tray}" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource SectionBody}">
                            <StackPanel>
                                <CheckBox x:Name="TrayCheck" Content="{ui:T settings.tray}" Margin="0,0,0,4"
                                          ToolTip="{ui:T settings.tray.tip}"
                                          Checked="Tray_Changed" Unchecked="Tray_Changed"/>
                                <CheckBox x:Name="MinTrayCheck" Content="{ui:T settings.tray.min}"
                                          ToolTip="{ui:T settings.tray.min.tip}"
                                          Checked="Tray_Changed" Unchecked="Tray_Changed"/>
                            </StackPanel>
                        </Border>

                        <ui:HotkeyPanel x:Name="Hotkeys"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{ui:T settings.tab.help}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="HelpPanel" Margin="2,0,10,8"/>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{ui:T settings.tab.about}">
                <!-- 背景: アイコンを半透明で中央に大きく（256px のフレームをそのまま使い、ぼかさない） -->
                <Grid>
                    <Image x:Name="AboutIcon" Width="256" Height="256" Opacity="0.16" IsHitTestVisible="False"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" UseLayoutRounding="True" SnapsToDevicePixels="True"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock TextAlignment="Center" Margin="0,0,0,14">
                            <Hyperlink x:Name="GitHubLink" NavigateUri="https://github.com/ghghuser/LokuOnX" RequestNavigate="Link_Navigate"><Run Text="{ui:T about.github}"/></Hyperlink>
                        </TextBlock>
                        <TextBlock TextAlignment="Center" Margin="0,0,0,14">
                            <Hyperlink x:Name="FolderLink" Click="OpenFolder_Click"><Run Text="{ui:T about.folder}"/></Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="1" Content="{ui:T settings.close}" Width="90" Padding="0,5" Margin="0,12,0,0" IsCancel="True" IsDefault="True" HorizontalAlignment="Right"/>
    </Grid>
</Window>

<UserControl x:Class="Recorder.UI.DetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Recorder.UI">
    <StackPanel>
        <!-- 日付フォルダ（保存先の下の行） -->
        <WrapPanel Margin="0,0,0,6">
            <TextBlock Text="日付フォルダ" Width="90" VerticalAlignment="Center"/>
            <CheckBox x:Name="DateFolderCheck" Content="作る" VerticalAlignment="Center"
                      Margin="0,0,10,0" Checked="DateFolder_Changed" Unchecked="DateFolder_Changed"/>
            <TextBox x:Name="DateFormatBox" Width="180" VerticalContentAlignment="Center"
                     ToolTip="日付フォルダの名前（録音開始日で固定）"
                     LostFocus="DateFormat_LostFocus"/>
            <Button Content="？" Width="28" Margin="6,0,0,0"
                    ToolTip="変数の説明を開く（変数のボタンで入力もできます）" Click="DateFormatHelp_Click"/>
        </WrapPanel>
        <!-- ファイル名テンプレート -->
        <WrapPanel Margin="0,0,0,6">
            <TextBlock Text="ファイル名" Width="90" VerticalAlignment="Center"/>
            <ComboBox x:Name="TemplateBox" Width="200" IsEditable="True" Margin="0,0,8,0"
                      ToolTip="選ぶと下のパターンに入ります。名前を書いて「保存」すると新しいテンプレートになります"
                      SelectionChanged="Template_Selected"/>
            <Button Content="保存" Padding="12,3" Margin="0,0,6,0" Click="SaveTemplate_Click"/>
            <Button Content="削除" Padding="12,3" Margin="0,0,6,0" Click="DeleteTemplate_Click"/>
            <Button Content="初期テンプレートを復元" Padding="12,3" Click="RestoreTemplates_Click"/>
        </WrapPanel>
        <DockPanel Margin="0,0,0,6">
            <TextBlock Text="パターン" Width="90" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <Button DockPanel.Dock="Right" Content="？" Width="28" Margin="6,0,0,0"
                    ToolTip="変数の説明を開く（変数のボタンで入力もできます）" Click="PatternHelp_Click"/>
            <TextBox x:Name="PatternBox" VerticalContentAlignment="Center"
                     TextChanged="Pattern_TextChanged" LostFocus="Pattern_LostFocus"/>
        </DockPanel>
        <TextBlock x:Name="ExampleText" Margin="90,0,0,8" Opacity="0.75" TextWrapping="Wrap"/>

        <!-- 番号（常時表示） -->
        <WrapPanel Margin="0,0,0,8">
            <TextBlock Text="番号" Width="90" VerticalAlignment="Center"/>
            <TextBlock Text="No の開始値" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ui:NumberBox x:Name="NoBox" Width="70" Minimum="1" Maximum="999999999" Margin="0,0,18,0"
                     ToolTip="次の録音に使う No。録音のたびに +1 され、終了後も維持されます"
                     LostFocus="No_LostFocus"/>
            <TextBlock Text="Track の開始値" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ui:NumberBox x:Name="TrackBox" Width="70" Minimum="1" Maximum="999999999"
                     ToolTip="新しい録音ごとにこの番号へ戻ります（分割のたびに +1）"
                     LostFocus="Track_LostFocus"/>
        </WrapPanel>
    </StackPanel>
</UserControl>

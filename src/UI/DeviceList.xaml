<UserControl x:Class="Recorder.UI.DeviceList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Recorder.UI">
    <UserControl.Resources>
        <ui:DeviceIconBrushConverter x:Key="IconBrush"/>
        <ui:WarnBrushConverter x:Key="WarnBrush"/>
        <!-- プルダウンの1項目: アイコン（色付き）・名前・既定のデバイスの ＊（赤紫）。色は Theme/Common.xaml。注意が出る選択肢（同じデバイスの重複など）は名前が赤系（WarnBrushConverter） -->
        <DataTemplate x:Key="DeviceItem">
            <TextBlock>
                <Run Text="{Binding Icon, Mode=OneWay}" Foreground="{Binding Icon, Mode=OneWay, Converter={StaticResource IconBrush}}"/><Run Text="{Binding LabelAfterIcon, Mode=OneWay}"><Run.Foreground><MultiBinding Converter="{StaticResource WarnBrush}"><Binding Path="Key"/><Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ComboBox}"/><Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=ComboBoxItem}"/><Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=ComboBox}"/></MultiBinding></Run.Foreground></Run><Run Text="{Binding DefaultMark, Mode=OneWay}" Foreground="{DynamicResource DefaultMarkFg}"/>
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>
    <!-- 録音コンソールの左側: 1行＝1デバイスの「ストリップ」（選択・波形・レベルとゲインの融合メーター）。行は DeviceList.xaml.cs が作る。
         列の幅は DeviceList.xaml.cs の Cols と同じ（見出しと行をそろえる） -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 見出し -->
        <Grid Grid.Row="0" Margin="0,0,0,6" TextElement.FontSize="11" TextElement.Foreground="{DynamicResource WindowFg}" Opacity="0.55">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="{ui:T devicelist.textblock1.text}" ToolTip="{ui:T devicelist.textblock2.tooltip}"/>
            <TextBlock Grid.Column="2" Text="{ui:T devicelist.textblock3.text}" Margin="2,0,0,0"/>
            <TextBlock Grid.Column="3" Text="{ui:T devicelist.textblock4.text}" ToolTip="{ui:T devicelist.textblock5.tooltip}"/>
        </Grid>

        <StackPanel Grid.Row="1">
            <StackPanel x:Name="RowsPanel"/>
        </StackPanel>

        <!-- 下段（コンソールの底にそろえる） -->
        <StackPanel x:Name="FooterPanel" Grid.Row="4" Margin="0,4,0,0" VerticalAlignment="Bottom" TextElement.FontSize="12">
            <DockPanel x:Name="FooterRow" LastChildFill="False">
                <Button x:Name="RefreshButton" Content="{ui:T devicelist.refreshbutton.content}" Padding="12,2" Margin="0,0,24,0"
                        ToolTip="{ui:T devicelist.refreshbutton.tooltip}"
                        Click="Refresh_Click"/>
                <TextBlock Text="{ui:T devicelist.textblock6.text}" VerticalAlignment="Center" Margin="0,0,10,0"
                           ToolTip="{ui:T devicelist.textblock7.tooltip}"/>
                <RadioButton x:Name="MixRadio" Content="{ui:T devicelist.mixradio.content}" GroupName="DeviceMode"
                             Margin="0,0,16,0" VerticalAlignment="Center" Checked="Mode_Checked"/>
                <RadioButton x:Name="SeparateRadio" Content="{ui:T devicelist.separateradio.content}" GroupName="DeviceMode"
                             VerticalAlignment="Center" Checked="Mode_Checked"/>
            </DockPanel>
        </StackPanel>
        <!-- エラーは「デバイス再取得」の行のすぐ上に出す -->
        <StackPanel Grid.Row="3">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource WarnFg}" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed"
                       Margin="0,6,0,0"/>
            <!-- 注意（黄）: いま選んでいる入力が、出力の出力先と同じデバイスで、その出力が音回り防止で止まるとき -->
            <TextBlock x:Name="CautionText" Foreground="{DynamicResource CautionFg}" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed"
                       Margin="0,6,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>

<UserControl x:Class="Recorder.UI.DeviceList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 録音コンソールの右側: 1行＝1デバイスの「ストリップ」（選択・波形・ゲイン・レベル）。行は DeviceList.xaml.cs が作る。
         列の幅は DeviceList.xaml.cs の Cols と同じ（見出しと行をそろえる） -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 見出し -->
        <Grid Grid.Row="0" Margin="0,0,0,6" TextElement.FontSize="11" TextElement.Foreground="{DynamicResource WindowFg}" Opacity="0.55">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="116"/>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="66"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="入力デバイス" ToolTip="PC内部音（🔊）・マイク（🎤）。最大4台を同時に録音できます（使う行だけデバイスを選んでください）"/>
            <TextBlock Grid.Column="2" Text="波形" Margin="2,0,0,0"/>
            <TextBlock Grid.Column="3" Text="ゲイン" ToolTip="録音中も調整できます。ダブルクリックで 0 dB"/>
            <TextBlock Grid.Column="5" Text="レベル"/>
        </Grid>

        <StackPanel Grid.Row="1">
            <StackPanel x:Name="RowsPanel"/>
            <!-- 全体ゲイン（ミックス後・録音するファイルに掛かる）。列はデバイスの行と同じ -->
            <Rectangle Height="1" Fill="{DynamicResource CardBorder}" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="116"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="66"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="全体ゲイン（ミックス後）" VerticalAlignment="Center" Opacity="0.85"
                           ToolTip="すべてのデバイスを混ぜたあとの音量（録音するファイルに掛かります）。左端＝ミュート。ダブルクリックで 0 dB。録音中も調整できます"/>
                <Slider x:Name="MasterSlider" Grid.Column="3" VerticalAlignment="Center"
                        ToolTip="全体ゲイン。左端＝ミュート。ダブルクリックで 0 dB に戻ります。録音中も調整可能。"
                        ValueChanged="Master_ValueChanged" MouseDoubleClick="Master_DoubleClick"/>
                <TextBlock x:Name="MasterText" Grid.Column="4" VerticalAlignment="Center" TextAlignment="Right"
                           Margin="0,0,10,0" FontSize="12"/>
            </Grid>
        </StackPanel>

        <!-- 下段（コンソールの底にそろえる） -->
        <StackPanel x:Name="FooterPanel" Grid.Row="3" Margin="0,4,0,0" VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RefreshButton" Content="デバイス再取得" Padding="12,2" Margin="0,0,24,0"
                        ToolTip="接続されているデバイスの一覧を読み直します（3秒ごとの自動更新もあります）"
                        Click="Refresh_Click"/>
                <TextBlock Text="複入力時の保存方法：" VerticalAlignment="Center" Margin="0,0,10,0"
                           ToolTip="2台以上のデバイスを同時に録音するときの保存のしかた"/>
                <RadioButton x:Name="MixRadio" Content="ミックスして1ファイル" GroupName="DeviceMode"
                             Margin="0,0,16,0" VerticalAlignment="Center" Checked="Mode_Checked"/>
                <RadioButton x:Name="SeparateRadio" Content="デバイスごとに別ファイル" GroupName="DeviceMode"
                             VerticalAlignment="Center" Checked="Mode_Checked"/>
            </StackPanel>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Grid.Row="4" Foreground="#D33" TextWrapping="Wrap" Visibility="Collapsed"
                   Margin="0,6,0,0"/>
    </Grid>
</UserControl>

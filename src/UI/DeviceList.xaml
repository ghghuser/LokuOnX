<UserControl x:Class="Recorder.UI.DeviceList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel x:Name="RowsPanel"/>
        <WrapPanel x:Name="FooterPanel">
            <Button x:Name="AddButton" Content="＋ デバイスを追加" Padding="12,2" Margin="0,0,18,4"
                    ToolTip="複数のデバイスを同時に録音します（例: マイク＋PC音）"
                    Click="Add_Click"/>
            <RadioButton x:Name="MixRadio" Content="ミックスして1ファイル" GroupName="DeviceMode"
                         Margin="0,0,16,4" VerticalAlignment="Center" Checked="Mode_Checked"/>
            <RadioButton x:Name="SeparateRadio" Content="デバイスごとに別ファイル" GroupName="DeviceMode"
                         Margin="0,0,0,4" VerticalAlignment="Center" Checked="Mode_Checked"/>
        </WrapPanel>
    </StackPanel>
</UserControl>

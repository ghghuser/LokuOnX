<UserControl x:Class="Recorder.UI.DeviceList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Recorder.UI">
    <UserControl.Resources>
        <ui:DeviceIconBrushConverter x:Key="IconBrush"/>
        <ui:WarnBrushConverter x:Key="WarnBrush"/>
        <!-- プルダウンの1項目: アイコン（色付き）・名前・既定のデバイスの ＊（赤紫）。色は Theme/Common.xaml。注意が出る選択肢（同じデバイスの重複など）は名前が赤系（WarnBrushConverter） -->
        <DataTemplate x:Key="DeviceItem">
            <TextBlock>
                <Run Text="{Binding Icon, Mode=OneWay}" Foreground="{Binding Icon, Mode=OneWay, Converter={StaticResource IconBrush}}"/><Run Text="{Binding LabelAfterIcon, Mode=OneWay}"><Run.Foreground><MultiBinding Converter="{StaticResource WarnBrush}"><Binding Path="Key"/><Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ComboBox}"/></MultiBinding></Run.Foreground></Run><Run Text="{Binding DefaultMark, Mode=OneWay}" Foreground="{DynamicResource DefaultMarkFg}"/>
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>
    <!-- 録音コンソールの左側: 1行＝1デバイスの「ストリップ」（選択・波形・レベルとゲインの融合メーター）。行は DeviceList.xaml.cs が作る。
         列の幅は DeviceList.xaml.cs の Cols と同じ（見出しと行をそろえる） -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 見出し -->
        <Grid Grid.Row="0" Margin="0,0,0,6" TextElement.FontSize="11" TextElement.Foreground="{DynamicResource WindowFg}" Opacity="0.55">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="入力デバイス" ToolTip="PC内部音（🔊）・マイク（🎤）。最大4台を同時に録音できます（使う行だけデバイスを選んでください）"/>
            <TextBlock Grid.Column="2" Text="波形" Margin="2,0,0,0"/>
            <TextBlock Grid.Column="3" Text="レベル・ゲイン" ToolTip="メーター＝音量（左右。下の数字は dB）、縦長のつまみ＝ゲイン。録音中も調整できます。ダブルクリックで 0 dB"/>
        </Grid>

        <StackPanel Grid.Row="1">
            <StackPanel x:Name="RowsPanel"/>
        </StackPanel>

        <!-- 下段（コンソールの底にそろえる） -->
        <StackPanel x:Name="FooterPanel" Grid.Row="3" Margin="0,4,0,0" VerticalAlignment="Bottom" TextElement.FontSize="12">
            <DockPanel x:Name="FooterRow" LastChildFill="False">
                <Button x:Name="RefreshButton" Content="デバイス再取得" Padding="12,2" Margin="0,0,24,0"
                        ToolTip="接続されているデバイスの一覧を読み直します（3秒ごとの自動更新もあります）"
                        Click="Refresh_Click"/>
                <TextBlock Text="複入力時の保存方法：" VerticalAlignment="Center" Margin="0,0,10,0"
                           ToolTip="2台以上のデバイスを同時に録音するときの保存のしかた"/>
                <RadioButton x:Name="MixRadio" Content="ミックスして1ファイル" GroupName="DeviceMode"
                             Margin="0,0,16,0" VerticalAlignment="Center" Checked="Mode_Checked"/>
                <RadioButton x:Name="SeparateRadio" Content="デバイスごとに別ファイル" GroupName="DeviceMode"
                             VerticalAlignment="Center" Checked="Mode_Checked"/>
            </DockPanel>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Grid.Row="4" Foreground="#D33" TextWrapping="Wrap" Visibility="Collapsed"
                   Margin="0,6,0,0"/>
    </Grid>
</UserControl>

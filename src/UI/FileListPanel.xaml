<UserControl x:Class="Recorder.UI.FileListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 起動後に作られたファイルは文字色を変える（選択中の行は選択色と重なるので変えない） -->
        <Style x:Key="RowText" TargetType="TextBlock">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsNew}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource NewFileFg}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 見出しと操作ボタン（幅が足りなければ折り返す） -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock x:Name="CountText" Text="ファイル一覧" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,4"/>
            <Button x:Name="RefreshButton" Content="更新" Padding="10,3" Margin="0,0,6,4" Click="Refresh_Click"
                    ToolTip="保存先フォルダ（日付フォルダの中も）を読み直します"/>
            <Button x:Name="ExplorerButton" Content="エクスプローラーで開く" Padding="10,3" Margin="0,0,6,4" Click="Explorer_Click"/>
            <Button x:Name="RenameButton" Content="名前の変更" Padding="10,3" Margin="0,0,6,4" Click="Rename_Click"
                    ToolTip="F2 キーでも開けます"/>
            <Button x:Name="DeleteButton" Content="ごみ箱へ削除" Padding="10,3" Margin="0,0,0,4" Click="Delete_Click"
                    ToolTip="Delete キーでも実行できます（複数選択可）"/>
        </WrapPanel>

        <!-- 録音中は、これからできるファイルがあることを一覧の一番上に出す -->
        <Border x:Name="RecordingBanner" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,4" Padding="8,5"
                BorderBrush="#D33" BorderThickness="1" CornerRadius="3">
            <TextBlock x:Name="RecordingText" Foreground="#D33" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <ListView x:Name="List" Grid.Row="2" MinHeight="110" SelectionMode="Extended"
                  SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_DoubleClick"
                  PreviewKeyDown="List_KeyDown"
                  GridViewColumnHeader.Click="Header_Click">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="再生" Click="Play_Click"/>
                    <MenuItem Header="エクスプローラーで開く" Click="Explorer_Click"/>
                    <MenuItem Header="名前の変更" InputGestureText="F2" Click="Rename_Click"/>
                    <MenuItem Header="ごみ箱へ削除" InputGestureText="Delete" Click="Delete_Click"/>
                    <Separator/>
                    <MenuItem Header="更新" Click="Refresh_Click"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn Header="ファイル名" Width="250">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource RowText}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="長さ" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding LengthText}" Style="{StaticResource RowText}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="サイズ" Width="76">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding SizeText}" Style="{StaticResource RowText}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="作成日時" Width="130">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding CreatedText}" Style="{StaticResource RowText}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="#D33" FontWeight="SemiBold" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,4,0,0"/>
        <TextBlock x:Name="HintText" Grid.Row="3" Opacity="0.65" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="起動後に作られたファイルは色付きで表示されます"/>
    </Grid>
</UserControl>

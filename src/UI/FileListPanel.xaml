<UserControl x:Class="Recorder.UI.FileListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Recorder.UI">
    <UserControl.Resources>
        <!-- タブの見出しだけ（中身は下の一覧を共有するので、タブの中身の領域は持たない） -->
        <ControlTemplate x:Key="HeaderOnlyTabs" TargetType="TabControl">
            <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1">
                <TabPanel IsItemsHost="True"/>
            </Border>
        </ControlTemplate>
        <!-- 文字色: 起動後に作られたファイル＝白に近い色、それ以前＝わずかに薄いグレー（ダーク）。選択中の行は通常色、録音中の行は赤 -->
        <Style x:Key="RowText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OldFileFg}"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsNew}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource NewFileFg}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                    <Setter Property="Foreground" Value="#C94A86"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MarkText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MarkFg}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                    <Setter Property="Foreground" Value="#C94A86"/>
                    <Setter Property="FontSize" Value="8"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 表示する場所（タブ: 録音履歴／フォルダ）と操作ボタン。幅が足りなければ折り返す -->
        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TabControl x:Name="SourceTabs" Template="{StaticResource HeaderOnlyTabs}" Margin="0,0,0,8"
                        SelectionChanged="SourceTab_Changed">
                <TabItem Header="{ui:T filelistpanel.tabitem1.header}"
                         ToolTip="{ui:T filelistpanel.tabitem2.tooltip}"/>
                <TabItem Header="{ui:T filelistpanel.tabitem3.header}"
                         ToolTip="{ui:T filelistpanel.tabitem4.tooltip}"/>
            </TabControl>
            <WrapPanel>
                <Button x:Name="ClearButton" Content="{ui:T filelistpanel.clearbutton.content}" Padding="10,3" Margin="0,0,10,4" Click="Clear_Click"
                        ToolTip="{ui:T filelistpanel.clearbutton.tooltip}"/>
                <ComboBox x:Name="SourceBox" Width="250" Margin="0,0,10,4" DisplayMemberPath="Label"
                          SelectionChanged="Source_Changed"
                          ToolTip="{ui:T filelistpanel.sourcebox.tooltip}"/>
                <Button x:Name="SaveFolderButton" Content="{ui:T filelistpanel.savefolderbutton.content}" Padding="10,3" Margin="0,0,6,4" Click="ShowSaveFolder_Click"
                        ToolTip="{ui:T filelistpanel.savefolderbutton.tooltip}"/>
                <Button x:Name="PickFolderButton" Content="{ui:T filelistpanel.pickfolderbutton.content}" Padding="10,3" Margin="0,0,10,4" Click="PickFolder_Click"
                        ToolTip="{ui:T filelistpanel.pickfolderbutton.tooltip}"/>
                <Button x:Name="RefreshButton" Content="{ui:T filelistpanel.refreshbutton.content}" Padding="10,3" Margin="0,0,10,4" Click="Refresh_Click"/>
                <TextBlock Text="{ui:T filelistpanel.textblock1.text}" VerticalAlignment="Center" Margin="0,0,6,4" Opacity="0.8"/>
                <TextBox x:Name="FilterBox" Width="130" Margin="0,0,10,4" VerticalContentAlignment="Center"
                         ToolTip="{ui:T filelistpanel.filterbox.tooltip}"
                         TextChanged="Filter_Changed"/>
                <TextBlock x:Name="CountText" VerticalAlignment="Center" MinWidth="64" Margin="0,0,0,4" Opacity="0.8"
                           ToolTip="{ui:T filelistpanel.counttext.tooltip}"/>
            </WrapPanel>
        </StackPanel>

        <ListView x:Name="List" Grid.Row="1" MinHeight="110" SelectionMode="Extended" FontSize="12" Background="{DynamicResource InputBg}"
                  SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_DoubleClick"
                  PreviewKeyDown="List_KeyDown"
                  GridViewColumnHeader.Click="Header_Click">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{ui:T filelistpanel.menuitem1.header}" Click="Play_Click"/>
                    <MenuItem Header="{ui:T filelistpanel.menuitem2.header}" Click="Explorer_Click"/>
                    <MenuItem Header="{ui:T filelistpanel.menuitem3.header}" InputGestureText="F2" Click="Rename_Click"/>
                    <MenuItem Header="{ui:T filelistpanel.menuitem4.header}" InputGestureText="Delete" Click="Delete_Click"/>
                    <Separator/>
                    <MenuItem Header="{ui:T filelistpanel.menuitem5.header}" Click="Refresh_Click"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn Header="{ui:T filelistpanel.gridviewcolumn1.header}" Width="260">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="-7,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Mark}" Style="{StaticResource MarkText}" TextAlignment="Left"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource RowText}" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{ui:T filelistpanel.gridviewcolumn2.header}" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding LengthText}" Style="{StaticResource RowText}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{ui:T filelistpanel.gridviewcolumn3.header}" Width="76">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding SizeText}" Style="{StaticResource RowText}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{ui:T filelistpanel.gridviewcolumn4.header}" Width="130">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding CreatedText}" Style="{StaticResource RowText}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#D33" FontWeight="SemiBold" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,4,0,0"/>

        <!-- プレイヤー（MainWindow から Footer で入れる） -->
        <ContentPresenter x:Name="Slot" Grid.Row="3" Margin="0,8,0,0"/>

        <!-- ファイル操作（プレイヤーの下） -->
        <WrapPanel Grid.Row="4" Margin="0,8,0,0">
            <Button x:Name="ExplorerButton" Content="{ui:T filelistpanel.explorerbutton.content}" Padding="10,3" Margin="0,0,6,0" Click="Explorer_Click"/>
            <Button x:Name="RenameButton" Content="{ui:T filelistpanel.renamebutton.content}" Padding="10,3" Margin="0,0,6,0" Click="Rename_Click"
                    ToolTip="{ui:T filelistpanel.renamebutton.tooltip}"/>
            <Button x:Name="DeleteButton" Content="{ui:T filelistpanel.deletebutton.content}" Padding="10,3" Margin="0,0,0,0" Click="Delete_Click"
                    ToolTip="{ui:T filelistpanel.deletebutton.tooltip}"/>
        </WrapPanel>
    </Grid>
</UserControl>

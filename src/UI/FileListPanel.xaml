<UserControl x:Class="Recorder.UI.FileListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- タブの見出しだけ（中身は下の一覧を共有するので、タブの中身の領域は持たない） -->
        <ControlTemplate x:Key="HeaderOnlyTabs" TargetType="TabControl">
            <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1">
                <TabPanel IsItemsHost="True"/>
            </Border>
        </ControlTemplate>
        <!-- 文字色: 起動後に作られたファイル＝白に近い色、それ以前＝わずかに薄いグレー（ダーク）。選択中の行は通常色、録音中の行は赤 -->
        <Style x:Key="RowText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OldFileFg}"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsNew}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource NewFileFg}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource WindowFg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                    <Setter Property="Foreground" Value="#C94A86"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MarkText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MarkFg}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                    <Setter Property="Foreground" Value="#C94A86"/>
                    <Setter Property="FontSize" Value="8"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 表示する場所（タブ: 録音履歴／フォルダ）と操作ボタン。幅が足りなければ折り返す -->
        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TabControl x:Name="SourceTabs" Template="{StaticResource HeaderOnlyTabs}" Margin="0,0,0,8"
                        SelectionChanged="SourceTab_Changed">
                <TabItem Header="録音履歴"
                         ToolTip="録音したファイルを、空にするまで残します"/>
                <TabItem Header="フォルダ"
                         ToolTip="好きなフォルダの中身を表示します（最近のフォルダ10件まで）"/>
            </TabControl>
            <WrapPanel>
                <Button x:Name="ClearButton" Content="履歴を空にする" Padding="10,3" Margin="0,0,10,4" Click="Clear_Click"
                        ToolTip="録音履歴の一覧を空にします（ファイルは消えません）"/>
                <ComboBox x:Name="SourceBox" Width="250" Margin="0,0,10,4" DisplayMemberPath="Label"
                          SelectionChanged="Source_Changed"
                          ToolTip="表示するフォルダ（最近のフォルダ10件まで）"/>
                <Button x:Name="SaveFolderButton" Content="保存先を表示" Padding="10,3" Margin="0,0,6,4" Click="ShowSaveFolder_Click"
                        ToolTip="いまの保存先フォルダの中身を一覧に表示します"/>
                <Button x:Name="PickFolderButton" Content="フォルダを選んで表示…" Padding="10,3" Margin="0,0,10,4" Click="PickFolder_Click"
                        ToolTip="好きなフォルダを選んで、その中身を一覧に表示します（最近の10件に入ります）"/>
                <Button x:Name="RefreshButton" Content="更新" Padding="10,3" Margin="0,0,10,4" Click="Refresh_Click"/>
                <TextBlock Text="絞り込み" VerticalAlignment="Center" Margin="0,0,6,4" Opacity="0.8"/>
                <TextBox x:Name="FilterBox" Width="130" Margin="0,0,10,4" VerticalContentAlignment="Center"
                         ToolTip="ファイル名に含まれる文字で絞り込みます（大文字・小文字は区別しません）。ファイル名に日付が入っていれば、日付でも探せます（例: 2026_10 ＝ 2026年10月）"
                         TextChanged="Filter_Changed"/>
                <TextBlock x:Name="CountText" VerticalAlignment="Center" MinWidth="64" Margin="0,0,0,4" Opacity="0.8"
                           ToolTip="表示中のファイル数（絞り込み中は「表示 / 全体」。4桁までは幅が固定で、5桁以上になると広がります）"/>
            </WrapPanel>
        </StackPanel>

        <ListView x:Name="List" Grid.Row="1" MinHeight="110" SelectionMode="Extended"
                  SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_DoubleClick"
                  PreviewKeyDown="List_KeyDown"
                  GridViewColumnHeader.Click="Header_Click">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="再生" Click="Play_Click"/>
                    <MenuItem Header="エクスプローラーで開く" Click="Explorer_Click"/>
                    <MenuItem Header="名前の変更" InputGestureText="F2" Click="Rename_Click"/>
                    <MenuItem Header="ごみ箱へ削除" InputGestureText="Delete" Click="Delete_Click"/>
                    <Separator/>
                    <MenuItem Header="更新" Click="Refresh_Click"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn Header="ファイル名" Width="260">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="-7,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Mark}" Style="{StaticResource MarkText}" TextAlignment="Left"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource RowText}" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="長さ" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding LengthText}" Style="{StaticResource RowText}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="サイズ" Width="76">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding SizeText}" Style="{StaticResource RowText}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="作成日時" Width="130">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding CreatedText}" Style="{StaticResource RowText}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#D33" FontWeight="SemiBold" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,4,0,0"/>

        <!-- プレイヤー（MainWindow から Footer で入れる） -->
        <ContentPresenter x:Name="Slot" Grid.Row="3" Margin="0,8,0,0"/>

        <!-- ファイル操作（プレイヤーの下） -->
        <WrapPanel Grid.Row="4" Margin="0,8,0,0">
            <Button x:Name="ExplorerButton" Content="エクスプローラーで開く" Padding="10,3" Margin="0,0,6,0" Click="Explorer_Click"/>
            <Button x:Name="RenameButton" Content="名前の変更" Padding="10,3" Margin="0,0,6,0" Click="Rename_Click"
                    ToolTip="F2 キーでも開けます"/>
            <Button x:Name="DeleteButton" Content="ごみ箱へ削除" Padding="10,3" Margin="0,0,0,0" Click="Delete_Click"
                    ToolTip="Delete キーでも実行できます（複数選択可）"/>
        </WrapPanel>
    </Grid>
</UserControl>

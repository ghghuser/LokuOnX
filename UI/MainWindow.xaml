<Window x:Class="Recorder.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LokuonX" Width="1000" Height="640"
        MinWidth="1000" MaxWidth="1280"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="12"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 上段: 設定 -->
        <GroupBox Grid.Row="0" Header="設定" Padding="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="入力デバイス" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,6">
                    <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="更新" Padding="10,2" Margin="6,0,0,0" Click="RefreshButton_Click"/>
                    <ComboBox x:Name="DeviceCombo" DisplayMemberPath="Name"/>
                </DockPanel>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="形式" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <ComboBox x:Name="FormatCombo" Grid.Row="0" Grid.Column="3" Width="90" Margin="0,0,0,6" SelectedIndex="0">
                    <ComboBoxItem Content="flac"/>
                    <ComboBoxItem Content="mp3"/>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="保存先" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="FolderBox" Grid.Row="1" Grid.Column="1" Margin="0,0,12,0" VerticalContentAlignment="Center"/>
                <Button x:Name="BrowseButton" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Content="参照..." Padding="14,2" HorizontalAlignment="Left" Click="BrowseButton_Click"/>
            </Grid>
        </GroupBox>

        <!-- 折りたたみ（今後のマイルストーンで中身を追加） -->
        <StackPanel Grid.Row="1" Margin="0,6,0,0">
            <Expander Header="詳細設定">
                <TextBlock Text="（音質・ファイル名テンプレートなどを今後追加します）" Margin="20,4,0,4"/>
            </Expander>
            <Expander Header="タグ">
                <TextBlock Text="（今後追加します）" Margin="20,4,0,4"/>
            </Expander>
            <Expander Header="オプション">
                <TextBlock Text="（今後追加します）" Margin="20,4,0,4"/>
            </Expander>
        </StackPanel>

        <!-- 中段: メーターと録音ボタン -->
        <GroupBox Grid.Row="2" Header="録音" Padding="6" Margin="0,6,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>

                <ProgressBar x:Name="MeterBar" Grid.Row="0" Grid.Column="0" Height="18" Minimum="0" Maximum="1" Value="0"/>
                <TextBlock x:Name="PeakText" Grid.Row="0" Grid.Column="1" Text="-∞ dB" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="StartButton" Content="● 録音開始" Padding="16,6" MinWidth="110" Click="StartButton_Click"/>
                    <Button x:Name="StopButton" Content="■ 停止" Padding="16,6" MinWidth="90" Margin="8,0,0,0" IsEnabled="False" Click="StopButton_Click"/>
                    <Button x:Name="SplitButton" Content="分割" Padding="16,6" MinWidth="70" Margin="8,0,0,0" IsEnabled="False" ToolTip="分割は今後のマイルストーンで追加します"/>
                    <TextBlock x:Name="ElapsedText" Text="0:00:00" FontSize="22" VerticalAlignment="Center" Margin="20,0,0,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 下段: ファイル一覧とプレイヤー（M6） -->
        <GroupBox Grid.Row="3" Header="ファイル一覧とプレイヤー" Padding="6" Margin="0,6,0,0" MinHeight="120">
            <TextBlock Text="（今後追加します）" Foreground="Gray"/>
        </GroupBox>

        <!-- 状態表示 -->
        <DockPanel Grid.Row="4" Margin="0,6,0,0" LastChildFill="True">
            <TextBlock x:Name="FfmpegText" DockPanel.Dock="Right" Margin="12,0,0,0"/>
            <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Margin="12,0,0,0"/>
            <TextBlock x:Name="StatusText" Text="待機中" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
